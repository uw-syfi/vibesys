+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Window [1000, 3000) ms.
+    fn fold() -> WindowFold {
+        WindowFold::new(
+            WindowSpec::from_flags(Some(1.0), Some(2.0))
+                .unwrap()
+                .unwrap(),
+            true,
+        )
+    }
+
+    fn sent(sent_ms: f64, arrivals: &[(f64, usize)], resolved_ms: f64) -> WindowObservation {
+        WindowObservation {
+            issued_ms: sent_ms,
+            sent_ms: Some(sent_ms),
+            first_output_after_send_ms: arrivals.first().map(|(at, _)| *at),
+            first_output_is_token_id: !arrivals.is_empty(),
+            token_arrivals: arrivals.to_vec(),
+            text_without_token_ids: false,
+            resolved_ms,
+        }
+    }
+
+    fn step(verdict: Verdict, observation: &WindowObservation) -> WindowedStep<'_> {
+        let output_len = observation.token_arrivals.iter().map(|(_, n)| n).sum();
+        WindowedStep {
+            verdict,
+            output_len_actual: output_len,
+            output_len_target: output_len,
+            round_idx: Some(1),
+            observation,
+        }
+    }
+
+    #[test]
+    fn flags_must_come_in_a_pair_with_a_positive_duration() {
+        assert_eq!(WindowSpec::from_flags(None, None).unwrap(), None);
+        assert!(WindowSpec::from_flags(Some(0.0), Some(5.0))
+            .unwrap()
+            .is_some());
+        for (warmup, duration) in [
+            (Some(1.0), None),
+            (None, Some(1.0)),
+            (Some(1.0), Some(0.0)),
+            (Some(-1.0), Some(1.0)),
+            (Some(1.0), Some(f64::NAN)),
+            (Some(f64::INFINITY), Some(1.0)),
+        ] {
+            assert!(
+                WindowSpec::from_flags(warmup, duration).is_err(),
+                "{warmup:?} {duration:?}"
+            );
+        }
+    }
+
+    #[test]
+    fn tokens_count_by_their_chunks_arrival_and_every_token_in_a_chunk_shares_it() {
+        let mut fold = fold();
+        // Sent at 500 ms; arrivals at 900 (before), 1000 (start, inclusive),
+        // 2999 (inside), 3000 (end, exclusive) ms since t0.
+        let observation = sent(
+            500.0,
+            &[(400.0, 4), (500.0, 3), (2499.0, 5), (2500.0, 7)],
+            3000.0,
+        );
+        fold.add(&step(Verdict::Cancelled, &observation));
+        let (summary, latencies) = fold.finish();
+
+        // A multi-token chunk counts in full at its own timestamp: 3 + 5.
+        assert_eq!(summary.output_tokens, 8);
+        assert_eq!(summary.requests_cancelled_at_window_end, 1);
+        assert_eq!(summary.requests_failed, 0);
+        // Sent during warmup: not in the TTFT population, but its in-window
+        // cadence is still a TPOT sample: 1999 ms over the 5 tokens after the
+        // first in-window event.
+        assert_eq!(summary.requests_submitted, 0);
+        assert!(latencies.ttfts_ms.is_empty());
+        assert_eq!(latencies.tpots_ms, vec![1999.0 / 5.0]);
+    }
+
+    #[test]
+    fn a_stream_wholly_inside_the_window_gets_exactly_its_own_tpot() {
+        // Same shape as the stream fold's own test: a 3-token first chunk then
+        // two single tokens, 20 ms apart -> 20 ms per token after the first event.
+        let mut fold = fold();
+        let observation = sent(1200.0, &[(100.0, 3), (120.0, 1), (140.0, 1)], 1400.0);
+        fold.add(&step(Verdict::Success, &observation));
+        let (summary, latencies) = fold.finish();
+
+        assert_eq!(latencies.tpots_ms, vec![20.0]);
+        assert_eq!(latencies.ttfts_ms, vec![100.0]);
+        assert_eq!(latencies.ttft_token_id_steps, 1);
+        assert_eq!(summary.requests_submitted, 1);
+        assert_eq!(summary.requests_first_token, 1);
+        assert_eq!(summary.output_tokens, 5);
+    }
+
+    #[test]
+    fn one_in_window_arrival_is_not_enough_for_tpot() {
+        let mut fold = fold();
+        let observation = sent(2900.0, &[(50.0, 4), (150.0, 1)], 3000.0);
+        fold.add(&step(Verdict::Cancelled, &observation));
+        let (summary, latencies) = fold.finish();
+
+        assert_eq!(summary.output_tokens, 4);
+        assert!(latencies.tpots_ms.is_empty());
+    }
+
+    #[test]
+    fn a_request_still_waiting_at_window_end_is_censored_not_dropped() {
+        let mut fold = fold();
+        let waiting = sent(2500.0, &[], 3000.0);
+        fold.add(&step(Verdict::Cancelled, &waiting));
+        let answered = sent(1500.0, &[(200.0, 1), (210.0, 1)], 1800.0);
+        fold.add(&step(Verdict::Success, &answered));
+        // Sent in warmup and still waiting: censored requests are only those
+        // submitted inside the window.
+        let warmup_waiting = sent(900.0, &[], 3000.0);
+        fold.add(&step(Verdict::Cancelled, &warmup_waiting));
+        let (summary, latencies) = fold.finish();
+
+        assert_eq!(summary.requests_submitted, 2);
+        assert_eq!(summary.ttft_censored_requests, 1);
+        assert_eq!(summary.requests_first_token, 1);
+        assert_eq!(summary.requests_cancelled_at_window_end, 2);
+        // The lower bound is window end minus send: 3000 - 2500.
+        let mut ttfts = latencies.ttfts_ms.clone();
+        ttfts.sort_by(f64::total_cmp);
+        assert_eq!(ttfts, vec![200.0, 500.0]);
+        assert_eq!(latencies.ttft_token_id_steps, 1);
+    }
+
+    #[test]
+    fn a_first_token_after_window_end_is_censored_too() {
+        let mut fold = fold();
+        // The stream raced the deadline and delivered at 3001 ms.
+        let late = sent(2800.0, &[(201.0, 2)], 3002.0);
+        fold.add(&step(Verdict::Success, &late));
+        let (summary, latencies) = fold.finish();
+
+        assert_eq!(summary.ttft_censored_requests, 1);
+        assert_eq!(latencies.ttfts_ms, vec![200.0]);
+        assert_eq!(summary.output_tokens, 0);
+    }
+
+    #[test]
+    fn a_real_failure_counts_and_contributes_no_tokens() {
+        let mut fold = fold();
+        let failed = sent(1500.0, &[(100.0, 2), (110.0, 2)], 1600.0);
+        fold.add(&step(Verdict::Failed, &failed));
+        let http_error = sent(1700.0, &[], 1705.0);
+        fold.add(&step(Verdict::Failed, &http_error));
+        let in_warmup = sent(10.0, &[], 20.0);
+        fold.add(&step(Verdict::Failed, &in_warmup));
+        let (summary, latencies) = fold.finish();
+
+        assert_eq!(summary.requests_failed, 2);
+        assert_eq!(summary.warmup_requests_failed, 1);
+        assert_eq!(summary.requests_cancelled_at_window_end, 0);
+        assert_eq!(summary.output_tokens, 0);
+        assert!(latencies.tpots_ms.is_empty());
+        // A failure that did produce a first token keeps its real TTFT, as a
+        // run without a window does; one that produced nothing has none and is
+        // not censored either.
+        assert_eq!(latencies.ttfts_ms, vec![100.0]);
+        assert_eq!(summary.ttft_censored_requests, 0);
+    }
+
+    #[test]
+    fn cancellation_is_outside_the_verdict_population() {
+        let fold = fold();
+        let cancelled = sent(1500.0, &[(100.0, 1)], 3000.0);
+        let done = sent(500.0, &[(100.0, 1)], 1200.0);
+        let warmup_done = sent(100.0, &[(100.0, 1)], 900.0);
+        assert!(!fold.reaches_verdict_in_window(&step(Verdict::Cancelled, &cancelled)));
+        assert!(fold.reaches_verdict_in_window(&step(Verdict::Success, &done)));
+        assert!(!fold.reaches_verdict_in_window(&step(Verdict::Success, &warmup_done)));
+    }
+
+    #[test]
+    fn sessions_started_counts_first_rounds_issued_inside_the_window() {
+        let mut fold = fold();
+        for (round_idx, issued_ms) in [(0, 500.0), (0, 1500.0), (1, 1600.0), (0, 2999.0)] {
+            let observation = WindowObservation::unsent(issued_ms);
+            fold.add(&WindowedStep {
+                verdict: Verdict::Skipped,
+                output_len_actual: 0,
+                output_len_target: 4,
+                round_idx: Some(round_idx),
+                observation: &observation,
+            });
+        }
+        assert_eq!(fold.finish().0.sessions_started, Some(2));
+
+        let independent = WindowFold::new(
+            WindowSpec::from_flags(Some(0.0), Some(1.0))
+                .unwrap()
+                .unwrap(),
+            false,
+        );
+        assert_eq!(independent.finish().0.sessions_started, None);
+    }
+
+    #[test]
+    fn text_without_token_ids_is_reported_rather_than_silently_dropped() {
+        let mut fold = fold();
+        let mut observation = sent(1500.0, &[], 1700.0);
+        observation.first_output_after_send_ms = Some(50.0);
+        observation.first_output_is_token_id = false;
+        observation.text_without_token_ids = true;
+        fold.add(&step(Verdict::Success, &observation));
+        let (summary, latencies) = fold.finish();
+
+        assert_eq!(summary.requests_without_token_ids, 1);
+        assert_eq!(summary.output_tokens, 0);
+        assert_eq!(latencies.ttft_text_fallback_steps, 1);
+    }
+}
