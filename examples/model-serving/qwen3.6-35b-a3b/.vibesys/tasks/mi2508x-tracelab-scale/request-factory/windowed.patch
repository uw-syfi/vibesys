diff --git a/tests/test_windowed_replay.py b/tests/test_windowed_replay.py
new file mode 100644
index 0000000..56aca18
--- /dev/null
+++ b/tests/test_windowed_replay.py
@@ -0,0 +1,457 @@
+"""Time-boxed measurement (`--warmup-secs` / `--duration-secs`), end to end.
+
+The pure window fold is tested beside its code in `src/window.rs`. What only a
+real run can show is the part that touches time: that the run really stops at
+window end with work still in flight, that what it abandons is reported as
+cancelled rather than failed, that a server failure inside the window still
+counts, that a request the server never answers enters TTFT as a censored lower
+bound, and that a run without the flags is the run it always was.
+
+The server is `src/bin/loadgen_perf_server.rs` with fixed pacing, so every
+expected number is arithmetic on its flags.
+"""
+
+from __future__ import annotations
+
+import json
+import socket
+import subprocess
+import time
+from contextlib import contextmanager
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+TARGET = REPO_ROOT / "target" / "debug"
+
+# `replay.common` exactly as a run without window flags has always written it:
+# a windowed run may change values, never this shape.
+COMMON_FIELDS = [
+    "attempted_steps",
+    "success_steps",
+    "failed_steps",
+    "target_output_tokens",
+    "actual_output_tokens",
+    "output_mismatch_steps",
+    "output_token_delta",
+    "total_duration_ms_sum",
+    "total_duration_ms_avg",
+    "total_duration_ms_p50",
+    "total_duration_ms_p90",
+    "total_duration_ms_max",
+    "ttft_ms_avg",
+    "ttft_ms_p50",
+    "ttft_ms_p90",
+    "ttft_ms_max",
+    "ttft_token_id_steps",
+    "ttft_text_fallback_steps",
+    "run_duration_ms",
+    "request_throughput_per_s",
+    "output_token_throughput_per_s",
+    "output_bytes",
+    "output_byte_throughput_per_s",
+    "media_output_steps",
+    "first_output_ms_avg",
+    "first_output_ms_p50",
+    "first_output_ms_p90",
+    "first_output_ms_max",
+    "audio_duration_s",
+    "audio_throughput_s_per_s",
+    "real_time_factor_measured_steps",
+    "real_time_factor_avg",
+    "real_time_factor_p50",
+    "real_time_factor_p90",
+    "real_time_factor_max",
+    "tpot_measured_steps",
+    "tpot_ms_avg",
+    "tpot_ms_p50",
+    "tpot_ms_p90",
+    "tpot_ms_max",
+    "completion_amortized_tpot_measured_steps",
+    "completion_amortized_tpot_ms_avg",
+    "completion_amortized_tpot_ms_p50",
+    "completion_amortized_tpot_ms_p90",
+    "completion_amortized_tpot_ms_max",
+    "context_overflow_steps",
+]
+
+WINDOW_FIELDS = [
+    "warmup_s",
+    "duration_s",
+    "output_tokens",
+    "requests_submitted",
+    "requests_first_token",
+    "ttft_censored_requests",
+    "requests_cancelled_at_window_end",
+    "requests_failed",
+    "requests_output_length_mismatch",
+    "warmup_requests_failed",
+    "sessions_started",
+    "requests_without_token_ids",
+]
+
+
+@pytest.fixture(scope="module", autouse=True)
+def _built() -> None:
+    subprocess.run(
+        ["cargo", "build", "--bin", "session_runner", "--bin", "loadgen_perf_server"],
+        cwd=REPO_ROOT,
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+
+
+@pytest.fixture(scope="module")
+def corpus(tmp_path_factory: pytest.TempPathFactory) -> tuple[Path, Path]:
+    """A word-level tokenizer and a corpus it covers: any ids will do."""
+
+    directory = tmp_path_factory.mktemp("corpus")
+    words = [f"w{index}" for index in range(997)]
+    vocab = {"[UNK]": 0} | {word: index + 1 for index, word in enumerate(words)}
+    tokenizer = directory / "tokenizer.json"
+    tokenizer.write_text(
+        json.dumps(
+            {
+                "version": "1.0",
+                "truncation": None,
+                "padding": None,
+                "added_tokens": [],
+                "normalizer": None,
+                "pre_tokenizer": {"type": "Whitespace"},
+                "post_processor": None,
+                "decoder": None,
+                "model": {"type": "WordLevel", "vocab": vocab, "unk_token": "[UNK]"},
+            }
+        )
+    )
+    text = directory / "corpus.txt"
+    text.write_text(
+        "\n".join(
+            " ".join(words[(line * 7 + column) % len(words)] for column in range(50))
+            for line in range(4000)
+        )
+        + "\n"
+    )
+    return tokenizer, text
+
+
+def write_trace(
+    path: Path,
+    sessions: int,
+    rounds: int,
+    input_len: int = 16,
+    output_len: int = 30,
+    tool_wait_ms: float = 0.0,
+) -> Path:
+    lines = [
+        "request_id,session_id,round_idx,arrival_time_ms,prefix_len,input_len,output_len,tool_wait_after_ms"
+    ]
+    for session in range(sessions):
+        session_id = f"s{session}"
+        context = 0
+        for round_idx in range(rounds):
+            lines.append(
+                f"session_{session_id}_round_{round_idx:06d},{session_id},{round_idx},"
+                f"{session:.6f},{context},{input_len},{output_len},{tool_wait_ms:.6f}"
+            )
+            context += input_len + output_len
+    path.write_text("\n".join(lines) + "\n")
+    return path
+
+
+def free_port() -> int:
+    with socket.socket() as probe:
+        probe.bind(("127.0.0.1", 0))
+        return probe.getsockname()[1]
+
+
+@contextmanager
+def server(*flags: str):
+    port = free_port()
+    process = subprocess.Popen(
+        [
+            str(TARGET / "loadgen_perf_server"),
+            "--bind",
+            f"127.0.0.1:{port}",
+            *flags,
+        ],
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+    )
+    try:
+        deadline = time.monotonic() + 10
+        while True:
+            try:
+                socket.create_connection(("127.0.0.1", port), timeout=0.2).close()
+                break
+            except OSError:
+                if time.monotonic() > deadline:
+                    raise
+                time.sleep(0.05)
+        yield port
+    finally:
+        process.kill()
+        process.wait()
+
+
+def run(
+    tmp_path: Path,
+    corpus: tuple[Path, Path],
+    port: int,
+    trace: Path,
+    *flags: str,
+) -> tuple[subprocess.CompletedProcess[str], float, dict | None, list[dict]]:
+    tokenizer, text = corpus
+    summary = tmp_path / "summary.json"
+    log = tmp_path / "requests.jsonl"
+    started = time.monotonic()
+    completed = subprocess.run(
+        [
+            str(TARGET / "session_runner"),
+            "--trace",
+            str(trace),
+            "--input-file-format",
+            "text-generation-session-execution-v2",
+            "--text-file",
+            str(text),
+            "--tokenizer",
+            str(tokenizer),
+            "--token-pool-limit",
+            "100000",
+            "--model",
+            "fake",
+            "--backend",
+            "openai",
+            "--base-url",
+            f"http://127.0.0.1:{port}/v1",
+            "--temperature",
+            "0",
+            "--timeline",
+            "false",
+            "--log-path",
+            str(log),
+            "--summary-path",
+            str(summary),
+            *flags,
+        ],
+        capture_output=True,
+        text=True,
+        timeout=120,
+        check=False,
+    )
+    elapsed = time.monotonic() - started
+    report = json.loads(summary.read_text()) if summary.exists() else None
+    records = (
+        [json.loads(line) for line in log.read_text().splitlines()]
+        if log.exists()
+        else []
+    )
+    return completed, elapsed, report, records
+
+
+def saturated(concurrency: int, warmup: float, duration: float) -> list[str]:
+    return [
+        "--arrival-mode",
+        "saturated",
+        "--max-concurrency",
+        str(concurrency),
+        "--warmup-secs",
+        str(warmup),
+        "--duration-secs",
+        str(duration),
+    ]
+
+
+def test_a_window_stops_in_flight_work_and_counts_a_real_failure(
+    tmp_path: Path, corpus: tuple[Path, Path]
+) -> None:
+    # Each request: 50 ms to its first chunk, then ten 3-token chunks 10 ms
+    # apart -> 140 ms for 30 tokens. Session s1's fifth round is sent at about
+    # 4 x 140 ms = 0.56 s, inside the [0.5, 2.0) s window, and fails.
+    trace = write_trace(tmp_path / "trace.csv", sessions=6, rounds=200)
+    with server(
+        "--tokens-per-chunk",
+        "3",
+        "--prefill-delay-ms",
+        "50",
+        "--chunk-delay-ms",
+        "10",
+        "--fail-request-id-containing",
+        "session_s1_round_000004",
+    ) as port:
+        completed, elapsed, report, records = run(
+            tmp_path, corpus, port, trace, *saturated(3, 0.5, 1.5)
+        )
+
+    assert completed.returncode == 0, completed.stderr
+    # 6 x 200 rounds at 140 ms each would take most of a minute.
+    assert elapsed < 20, elapsed
+    replay = report["replay"]
+    common, window = replay["common"], replay["window"]
+    assert list(common) == COMMON_FIELDS
+    assert list(window) == WINDOW_FIELDS
+    assert window["warmup_s"] == 0.5 and window["duration_s"] == 1.5
+
+    # Abandoned at window end: in the window block, never in failures.
+    statuses = [record["outcome"]["status"] for record in records]
+    cancelled = statuses.count("CANCELLED_AT_WINDOW_END")
+    assert 1 <= cancelled <= 3
+    assert window["requests_cancelled_at_window_end"] == cancelled
+    assert statuses.count("FAILED") == 1
+    assert window["requests_failed"] == 1
+    assert common["failed_steps"] == 1
+    assert window["warmup_requests_failed"] == 0
+    assert common["attempted_steps"] == common["success_steps"] + common["failed_steps"]
+
+    # Three sessions streaming 30 tokens per 140 ms, minus the one-off gaps
+    # around the failure and the session that replaced the failed one.
+    ideal = 3 * 30 / 0.140
+    assert common["run_duration_ms"] == 1500.0
+    assert window["output_tokens"] == pytest.approx(
+        common["output_token_throughput_per_s"] * 1.5
+    )
+    assert 0.6 * ideal < common["output_token_throughput_per_s"] < 1.1 * ideal
+    # 10 ms per 3-token chunk: the first chunk's three tokens are excluded.
+    assert 10 / 3 <= common["tpot_ms_p50"] < 6
+    assert 50 <= common["ttft_ms_p50"] < 150
+    # Whatever was still in its 50 ms prefill when the window closed is
+    # censored, and its lower bound is shorter than that prefill.
+    assert window["ttft_censored_requests"] <= cancelled
+    assert common["ttft_ms_max"] < 150
+    assert window["requests_submitted"] >= 3
+    assert window["requests_first_token"] >= window["requests_submitted"] - 3
+    # s3 replaced the failed s1 inside the window; s0-s2 started in warmup.
+    assert window["sessions_started"] == 1
+
+
+def test_a_request_never_answered_enters_ttft_as_a_censored_lower_bound(
+    tmp_path: Path, corpus: tuple[Path, Path]
+) -> None:
+    # The server sits on every request for 30 s, far past a 1 s window. A
+    # summary that dropped these requests would report no TTFT at all, or only
+    # the fast ones; censoring reports the wait so far.
+    trace = write_trace(tmp_path / "trace.csv", sessions=2, rounds=3)
+    with server("--prefill-delay-ms", "30000") as port:
+        completed, elapsed, report, records = run(
+            tmp_path, corpus, port, trace, *saturated(2, 0, 1)
+        )
+
+    assert completed.returncode == 0, completed.stderr
+    assert elapsed < 20, elapsed
+    common, window = report["replay"]["common"], report["replay"]["window"]
+    assert window["requests_submitted"] == 2
+    assert window["ttft_censored_requests"] == 2
+    assert window["requests_cancelled_at_window_end"] == 2
+    assert window["requests_failed"] == 0 and common["failed_steps"] == 0
+    assert window["output_tokens"] == 0
+    assert common["output_token_throughput_per_s"] == 0
+    # Both were sent within milliseconds of t0 and censored at t0 + 1 s.
+    assert 900 < common["ttft_ms_p50"] <= 1000
+    assert common["ttft_token_id_steps"] == 0
+    assert [record["outcome"]["status"] for record in records] == [
+        "CANCELLED_AT_WINDOW_END"
+    ] * 2
+
+
+def test_a_tool_wait_is_not_waited_out_past_window_end(
+    tmp_path: Path, corpus: tuple[Path, Path]
+) -> None:
+    trace = write_trace(tmp_path / "trace.csv", sessions=4, rounds=3, tool_wait_ms=60_000)
+    with server() as port:
+        completed, elapsed, report, records = run(
+            tmp_path, corpus, port, trace, *saturated(2, 0, 1)
+        )
+
+    assert completed.returncode == 0, completed.stderr
+    assert elapsed < 20, elapsed
+    window = report["replay"]["window"]
+    # Both sessions finished round 0 and then sat in a minute-long tool wait,
+    # holding their slots, so nobody else started and nothing was in flight.
+    assert window["sessions_started"] == 2
+    assert window["requests_cancelled_at_window_end"] == 0
