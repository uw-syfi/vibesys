+//! Time-boxed measurement: `--warmup-secs W --duration-secs D`.
+//!
+//! A trace far larger than any run can finish has no natural end, and servers
+//! that differ by orders of magnitude in speed would finish different amounts
+//! of it in any fixed budget. So a windowed run measures a fixed span of wall
+//! clock instead of a fixed amount of work: t0 is the moment measured replay
+//! starts (after the prefix-cache preflight), the window is
+//! `[t0 + W, t0 + W + D)`, and at its end every unit of in-flight work is
+//! abandoned rather than awaited.
+//!
+//! Everything here is measured on one monotonic clock, in milliseconds since
+//! t0. The executor stamps what it saw ([`WindowObservation`]); the fold
+//! ([`WindowFold`]) is a pure function of those stamps and the window bounds,
+//! which is what lets the edge cases be tested without a server.
+
+use std::time::{Duration, Instant};
+
+use anyhow::{bail, Result};
+use serde::Serialize;
+
+/// The validated pair of window flags.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct WindowSpec {
+    warmup_s: f64,
+    duration_s: f64,
+}
+
+impl WindowSpec {
+    /// `None` when neither flag was given. Pairing is enforced by clap; the
+    /// values are checked here because clap cannot say "finite and positive".
+    pub(crate) fn from_flags(
+        warmup_s: Option<f64>,
+        duration_s: Option<f64>,
+    ) -> Result<Option<Self>> {
+        match (warmup_s, duration_s) {
+            (None, None) => Ok(None),
+            (Some(warmup_s), Some(duration_s)) => {
+                if !warmup_s.is_finite() || warmup_s < 0.0 {
+                    bail!("--warmup-secs must be a finite number of seconds >= 0, got {warmup_s}");
+                }
+                if !duration_s.is_finite() || duration_s <= 0.0 {
+                    bail!(
+                        "--duration-secs must be a finite number of seconds > 0, got {duration_s}"
+                    );
+                }
+                Ok(Some(Self {
+                    warmup_s,
+                    duration_s,
+                }))
+            }
+            _ => bail!("--warmup-secs and --duration-secs must be given together"),
+        }
+    }
+
+    pub(crate) fn bounds(&self) -> WindowBounds {
+        WindowBounds {
+            start_ms: self.warmup_s * 1_000.0,
+            end_ms: (self.warmup_s + self.duration_s) * 1_000.0,
+        }
+    }
+
+    /// Anchor the window at t0.
+    pub(crate) fn start_at(&self, t0: Instant) -> WindowClock {
+        WindowClock {
+            t0,
+            end: t0 + Duration::from_secs_f64(self.warmup_s + self.duration_s),
+        }
+    }
+}
+
+/// The window in milliseconds since t0. Half-open: `[start_ms, end_ms)`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct WindowBounds {
+    pub(crate) start_ms: f64,
+    pub(crate) end_ms: f64,
+}
+
+impl WindowBounds {
+    fn contains(&self, at_ms: f64) -> bool {
+        at_ms >= self.start_ms && at_ms < self.end_ms
+    }
+
+    fn duration_s(&self) -> f64 {
+        (self.end_ms - self.start_ms) / 1_000.0
+    }
+}
+
+/// The run's clock, as the executors see it: where t0 is, and when to stop.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct WindowClock {
+    t0: Instant,
+    end: Instant,
+}
+
+impl WindowClock {
+    pub(crate) fn ms_since_t0(&self, at: Instant) -> f64 {
+        at.saturating_duration_since(self.t0).as_secs_f64() * 1_000.0
+    }
+
+    pub(crate) fn now_ms(&self) -> f64 {
+        self.ms_since_t0(Instant::now())
+    }
+
+    pub(crate) fn end(&self) -> Instant {
+        self.end
+    }
+
+    pub(crate) fn has_ended(&self) -> bool {
+        Instant::now() >= self.end
+    }
+
+    /// Resolves at window end. Every await that could outlast the window races
+    /// this, so nothing the run started is still waited on afterwards.
+    pub(crate) async fn until_end(&self) {
+        tokio::time::sleep_until(tokio::time::Instant::from_std(self.end)).await;
+    }
+}
+
+/// What one text request looked like on the window's clock.
+///
+/// Carried beside the step record and never serialized: the per-request JSONL
+/// contract does not change with windowing, and the arrivals list is only
+/// needed until the summary fold has reduced it.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub(crate) struct WindowObservation {
+    /// When the executor issued the request. Always present.
+    pub(crate) issued_ms: f64,
+    /// When the HTTP request was sent: the anchor of the record's own TTFT.
+    /// `None` for a request that never reached the wire.
+    pub(crate) sent_ms: Option<f64>,
+    /// First output after the send, on the same clock and with the same
+    /// preference as the record's TTFT: the first token-id event, else the
+    /// first text event.
+    pub(crate) first_output_after_send_ms: Option<f64>,
+    /// Whether that first output was a token-id event rather than text.
+    pub(crate) first_output_is_token_id: bool,
+    /// One entry per stream event that carried token ids: milliseconds after
+    /// the send, and how many tokens that one event delivered.
+    pub(crate) token_arrivals: Vec<(f64, usize)>,
+    /// Text streamed but never a token id, so tokens cannot be placed in time.
+    pub(crate) text_without_token_ids: bool,
+    /// When the request reached its verdict, or was abandoned.
+    pub(crate) resolved_ms: f64,
+}
+
+impl WindowObservation {
+    /// A request the executor decided not to send at all.
+    pub(crate) fn unsent(now_ms: f64) -> Self {
+        Self {
+            issued_ms: now_ms,
+            resolved_ms: now_ms,
+            ..Self::default()
+        }
+    }
+}
+
+/// How a request ended, as far as the window cares.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Verdict {
+    Success,
+    /// HTTP error, malformed stream, integrity failure: a real failure.
+    Failed,
+    /// Abandoned because the window ended. Not a failure.
+    Cancelled,
+    /// Never sent (context-limit skip).
+    Skipped,
+}
+
+/// One request as the fold consumes it.
+pub(crate) struct WindowedStep<'a> {
+    pub(crate) verdict: Verdict,
+    pub(crate) output_len_actual: usize,
+    pub(crate) output_len_target: usize,
+    /// `Some(round)` for a session round, `None` for an independent request.
+    pub(crate) round_idx: Option<usize>,
+    pub(crate) observation: &'a WindowObservation,
+}
+
+/// The `replay.window` block of the run summary.
+#[derive(Clone, Debug, Default, PartialEq, Serialize)]
+pub(crate) struct WindowSummary {
+    pub(crate) warmup_s: f64,
+    pub(crate) duration_s: f64,
+    /// Output tokens whose stream event arrived inside the window, from
+    /// requests that did not fail. The numerator of
+    /// `common.output_token_throughput_per_s`.
+    pub(crate) output_tokens: usize,
+    /// Requests whose HTTP send happened inside the window: the TTFT population.
+    pub(crate) requests_submitted: usize,
+    /// Requests whose first output arrived inside the window, whenever sent.
+    pub(crate) requests_first_token: usize,
+    /// Requests submitted inside the window that were still waiting for their
+    /// first output when it ended. Their TTFT enters the percentiles as the
+    /// lower bound `window end - send`.
+    pub(crate) ttft_censored_requests: usize,
+    /// Requests in flight when the window ended, abandoned. Not failures.
+    pub(crate) requests_cancelled_at_window_end: usize,
+    /// Requests that really failed and reached that verdict inside the window.
+    pub(crate) requests_failed: usize,
+    /// Requests that succeeded inside the window with an output length other
+    /// than the trace's target. Reported, not failed: the record status is
+    /// `SUCCESS`, exactly as `common.output_mismatch_steps` counts them.
+    pub(crate) requests_output_length_mismatch: usize,
+    /// Real failures during warmup. Outside every windowed metric, and counted
+    /// here so a failure is never invisible just because of when it happened.
+    pub(crate) warmup_requests_failed: usize,
+    /// Sessions whose first round was issued inside the window. `null` for an
+    /// independent-request workload.
+    pub(crate) sessions_started: Option<usize>,
+    /// Requests active in the window that streamed text but no token ids, so
+    /// their tokens could not be placed in time and are not in `output_tokens`.
+    /// Nonzero means the throughput is an undercount.
+    pub(crate) requests_without_token_ids: usize,
+}
+
+/// Window-derived distributions that replace the run-wide ones in
+/// `replay.common`.
+#[derive(Debug, Default)]
+pub(crate) struct WindowedLatencies {
+    /// Real and censored TTFTs together.
+    pub(crate) ttfts_ms: Vec<f64>,
+    pub(crate) ttft_token_id_steps: usize,
+    pub(crate) ttft_text_fallback_steps: usize,
+    pub(crate) tpots_ms: Vec<f64>,
+}
+
+/// The fold over every step a windowed run logged.
+#[derive(Debug)]
+pub(crate) struct WindowFold {
+    bounds: WindowBounds,
+    summary: WindowSummary,
+    latencies: WindowedLatencies,
+    is_sessions: bool,
+}
+
+impl WindowFold {
+    pub(crate) fn new(spec: WindowSpec, is_sessions: bool) -> Self {
+        Self {
+            bounds: spec.bounds(),
+            summary: WindowSummary {
+                warmup_s: spec.warmup_s,
+                duration_s: spec.duration_s,
+                ..WindowSummary::default()
+            },
+            latencies: WindowedLatencies::default(),
+            is_sessions,
+        }
+    }
+
+    pub(crate) fn duration_s(&self) -> f64 {
+        self.bounds.duration_s()
+    }
+
+    /// Whether a step belongs to the verdict population that the per-request
+    /// fields of `replay.common`, the prefix-cache block and the SLO fold
+    /// count: it reached a verdict (success, failure, or skip) inside the
+    /// window. A cancelled request never reached one.
+    pub(crate) fn reaches_verdict_in_window(&self, step: &WindowedStep) -> bool {
+        step.verdict != Verdict::Cancelled && self.bounds.contains(step.observation.resolved_ms)
+    }
+
+    pub(crate) fn add(&mut self, step: &WindowedStep) {
+        let bounds = self.bounds;
+        let observation = step.observation;
+        let summary = &mut self.summary;
+
+        match step.verdict {
+            Verdict::Cancelled => summary.requests_cancelled_at_window_end += 1,
+            Verdict::Failed if bounds.contains(observation.resolved_ms) => {
+                summary.requests_failed += 1
+            }
+            Verdict::Failed if observation.resolved_ms < bounds.start_ms => {
+                summary.warmup_requests_failed += 1
+            }
+            Verdict::Success
+                if bounds.contains(observation.resolved_ms)
+                    && step.output_len_actual != step.output_len_target =>
+            {
+                summary.requests_output_length_mismatch += 1
+            }
+            _ => {}
+        }
+
+        if step.round_idx == Some(0) && bounds.contains(observation.issued_ms) {
+            *summary.sessions_started.get_or_insert(0) += 1;
+        }
+
+        let Some(sent_ms) = observation.sent_ms else {
+            return;
+        };
+        let first_output_at = observation
+            .first_output_after_send_ms
+            .map(|after_send| sent_ms + after_send);
+        if first_output_at.is_some_and(|at| bounds.contains(at)) {
+            summary.requests_first_token += 1;
+        }
+
+        if bounds.contains(sent_ms) {
+            summary.requests_submitted += 1;
+            match (observation.first_output_after_send_ms, first_output_at) {
+                // The record's own TTFT, bit for bit.
+                (Some(ttft_ms), Some(at)) if at < bounds.end_ms => {
+                    self.latencies.ttfts_ms.push(ttft_ms);
+                    if observation.first_output_is_token_id {
+                        self.latencies.ttft_token_id_steps += 1;
+                    } else {
+                        self.latencies.ttft_text_fallback_steps += 1;
+                    }
+                }
+                // Still waiting when the window closed: the wait so far is a
+                // lower bound, and leaving it out would let a server look fast
+                // by never answering its slowest requests.
+                _ if step.verdict == Verdict::Cancelled
+                    || observation.resolved_ms >= bounds.end_ms =>
+                {
+                    summary.ttft_censored_requests += 1;
+                    self.latencies.ttfts_ms.push(bounds.end_ms - sent_ms);
+                }
+                // Failed (or finished empty) before any output: no TTFT,
+                // exactly as a run without a window treats it.
+                _ => {}
+            }
+        }
+
+        // A failed request's tokens are not delivered output, as in the
+        // run-wide throughput.
+        if step.verdict == Verdict::Failed {
+            return;
+        }
+        if observation.text_without_token_ids && observation.resolved_ms >= bounds.start_ms {
+            summary.requests_without_token_ids += 1;
+        }
+        let in_window = observation
+            .token_arrivals
+            .iter()
+            .filter(|(after_send, _)| bounds.contains(sent_ms + after_send));
+        let mut first: Option<f64> = None;
+        let mut last = 0.0;
+        let mut tokens_after_first = 0usize;
+        for &(after_send, tokens) in in_window {
+            // Every token in a chunk shares that chunk's arrival instant.
+            summary.output_tokens += tokens;
+            if first.is_none() {
+                first = Some(after_send);
+            } else {
+                tokens_after_first += tokens;
+            }
+            last = after_send;
+        }
+        // The same formula as the per-request `token_delivery_tpot_ms`, applied
+        // to the in-window events only: span between the first and last
+        // in-window event, over the tokens that arrived after the first. A
+        // stream wholly inside the window therefore gets exactly its own TPOT.
+        if let Some(first) = first {
+            if tokens_after_first > 0 && last >= first {
+                self.latencies
+                    .tpots_ms
+                    .push((last - first) / tokens_after_first as f64);
+            }
+        }
+    }
+
+    pub(crate) fn finish(mut self) -> (WindowSummary, WindowedLatencies) {
+        if self.is_sessions {
+            self.summary.sessions_started.get_or_insert(0);
+        }
+        (self.summary, self.latencies)
+    }
+}
