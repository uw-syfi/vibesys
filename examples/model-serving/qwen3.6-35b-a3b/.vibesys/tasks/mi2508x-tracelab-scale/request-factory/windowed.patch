+    /// Write a response segment by segment: headers, then the first token chunk
+    /// after the prefill delay, then each later segment after the chunk delay.
+    async fn write_paced(
+        socket: &mut TcpStream,
+        segments: &[Vec<u8>],
+        config: &Config,
+    ) -> io::Result<()> {
+        let (headers, events) = segments.split_first().expect("a response has headers");
+        socket.write_all(headers).await?;
+        socket.flush().await?;
+        tokio::time::sleep(config.prefill_delay).await;
+        for (index, segment) in events.iter().enumerate() {
+            if index > 0 {
+                tokio::time::sleep(config.chunk_delay).await;
+            }
+            socket.write_all(segment).await?;
+            socket.flush().await?;
+        }
+        Ok(())
+    }
