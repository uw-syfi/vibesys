+        SourceRecord::IndependentRequest(source) => (source.output_len_target, None),
+        SourceRecord::MultimodalRequest(source) => (source.output_len_target, None),
+    };
+    WindowedStep {
+        verdict,
+        output_len_actual: outcome.output_len_actual,
+        output_len_target,
+        round_idx,
+        observation,
+    }
