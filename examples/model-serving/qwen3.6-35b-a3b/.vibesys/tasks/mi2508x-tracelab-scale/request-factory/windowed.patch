+/// Where a measurement window means something, and where it does not.
+///
+/// Supported: text replay (sessions or independent requests) under
+/// `--arrival-mode saturated`, which is a closed-loop generator whose offered
+/// load is set by `--max-concurrency` and the server's own speed -- the case a
+/// fixed wall-clock window is for. Rejected, each for its own reason:
+///
+/// - `trace-timed`: the offered load is the trace's recorded timeline, so a
+///   window would measure whichever slice of that schedule it happened to
+///   cover, and the arrival waits are not window-aware;
+/// - multimodal replay: the media surfaces report whole outputs, not token
+///   events that can be placed on the window's clock;
+/// - `--dry-run`: nothing is sent, so nothing is measured;
+/// - `--shard-count > 1`: every process would anchor its own t0 after its own
+///   preflight, so the shards' windows would not line up, and the sharded
+///   summary merge knows nothing of window blocks.
+fn validate_window(args: &Args, format: InputFileFormat) -> Result<()> {
+    if WindowSpec::from_flags(args.warmup_secs, args.duration_secs)?.is_none() {
+        return Ok(());
+    }
+    if args.arrival_mode != ArrivalMode::Saturated {
+        return Err(anyhow!(
+            "--warmup-secs/--duration-secs measure a closed-loop run and require \
+             --arrival-mode saturated; under trace-timed the trace's own timeline sets the load, \
+             and a fixed window would measure whichever slice of it the window covered"
+        ));
+    }
+    if format == InputFileFormat::MultimodalIndependentV1 {
+        return Err(anyhow!(
+            "--warmup-secs/--duration-secs count streamed tokens and are text-replay-only; \
+             multimodal-independent-v1 is not supported"
+        ));
+    }
+    if args.dry_run {
+        return Err(anyhow!(
+            "--warmup-secs/--duration-secs cannot be used with --dry-run, which measures nothing"
+        ));
+    }
+    if args.shard_count > 1 {
+        return Err(anyhow!(
+            "--warmup-secs/--duration-secs require a single process (--shard-count 1): each shard \
+             would start its own window after its own preflight, and the windows would not align"
+        ));
+    }
+    Ok(())
+}
