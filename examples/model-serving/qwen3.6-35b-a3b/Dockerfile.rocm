# The candidate's image for the AMD AgentX tasks, which vibesys-cli runs (task schema 0.2,
# [candidate] in .vibesys/tasks/{mi2104x,mi300x}-agentx/vibesys.input.toml). vibesys-cli builds it
# from the candidate's commit, with the project root as the context (.dockerignore keeps only
# requirements-agentx.txt), and runs `python -m engine.server --host ... --port ...` in it from
# the checkout's root, with the task's AMD GPUs. The engine's code comes from the checkout; this
# image holds only its dependencies, installed as README.md says for Linux x86-64 with
# Python 3.12 and ROCm 6.4: torch 2.9.1+rocm6.4, then requirements-agentx.txt. It is part of the
# candidate, as the engine is: another base, a kernel library or a profiler may replace it.
#
# Model weights are never baked in: the operator mounts the Hugging Face cache read-only as
# "hf" (the task's [environment] needs), and the engine reads it offline.
FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c

COPY requirements-agentx.txt /tmp/requirements-agentx.txt
RUN pip install --no-cache-dir 'torch==2.9.1+rocm6.4' --index-url https://download.pytorch.org/whl/rocm6.4 \
 && pip install --no-cache-dir -r /tmp/requirements-agentx.txt \
 && rm /tmp/requirements-agentx.txt \
 && python -c "import torch; assert torch.version.hip, 'torch is not a ROCm build'; print('torch', torch.__version__, 'hip', torch.version.hip)"

# A job runs as the invoking user, whose HOME may not exist; the image's files are read-only
# under Apptainer, so caches (Triton, Hugging Face modules) go under /tmp.
ENV PYTHONUNBUFFERED=1 HOME=/tmp HF_HOME=/vibesys/mounts/hf HF_HUB_OFFLINE=1 \
    HF_MODULES_CACHE=/tmp/hf-modules
