{
  "id": "helper-project-missing",
  "protocol": "host-helper",
  "title": "Project requests on a missing directory",
  "description": "tasks.list, runs.list, runs.read_events, project.task_goal and run.start naming a directory that does not exist are each answered project_missing with the path, and nothing is launched.",
  "role": "control",
  "transports": [
    "stdio"
  ],
  "steps": [
    {
      "dir": "c2s",
      "frame": {
        "type": "hello",
        "request_id": "h",
        "deadline_ms": 10000,
        "client_versions": [
          1,
          1
        ],
        "features": [
          "instances_watch",
          "paths_complete",
          "project_goal",
          "run_history"
        ],
        "app_version": "conformance"
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "hello",
        "request_id": "h",
        "protocol_version": 1,
        "features": [
          "instances_watch",
          "paths_complete",
          "project_goal",
          "run_history"
        ]
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "tasks.list",
        "request_id": "t",
        "deadline_ms": 10000,
        "project": "/nonexistent-vibesys-conformance/project"
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "t",
        "code": "project_missing"
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "runs.list",
        "request_id": "r",
        "deadline_ms": 10000,
        "project": "/nonexistent-vibesys-conformance/project"
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "r",
        "code": "project_missing"
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "runs.read_events",
        "request_id": "e",
        "deadline_ms": 10000,
        "project": "/nonexistent-vibesys-conformance/project",
        "run_id": "20261010-120000-11111111-run",
        "from_sequence": 1,
        "max": 100
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "e",
        "code": "project_missing"
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "project.task_goal",
        "request_id": "g",
        "deadline_ms": 10000,
        "project": "/nonexistent-vibesys-conformance/project",
        "task": "default"
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "g",
        "code": "project_missing"
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "run.start",
        "request_id": "s",
        "deadline_ms": 10000,
        "project": "/nonexistent-vibesys-conformance/project",
        "task": "spsc"
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "s",
        "code": "project_missing"
      }
    }
  ]
}
