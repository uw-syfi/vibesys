{
  "id": "helper-handshake-required",
  "protocol": "host-helper",
  "title": "A request before hello is refused",
  "description": "Any request other than hello as the first message is answered handshake_required with its request id, and the channel still accepts hello afterwards.",
  "role": "control",
  "transports": [
    "stdio"
  ],
  "steps": [
    {
      "dir": "c2s",
      "frame": {
        "type": "ping",
        "request_id": "p",
        "deadline_ms": 10000
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "p",
        "code": "handshake_required"
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "hello",
        "request_id": "h",
        "deadline_ms": 10000,
        "client_versions": [
          1,
          1
        ],
        "features": [
          "instances_watch",
          "paths_complete"
        ],
        "app_version": "conformance"
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "hello",
        "request_id": "h",
        "protocol_version": 1,
        "features": [
          "instances_watch",
          "paths_complete"
        ]
      }
    }
  ]
}
