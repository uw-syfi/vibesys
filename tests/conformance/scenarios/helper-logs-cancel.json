{
  "id": "helper-logs-cancel",
  "protocol": "host-helper",
  "title": "Withdraw waiting reads past the worker limit",
  "description": "A follower that stops withdraws its waiting read with logs.cancel: the read answers at once with what it holds (here an empty chunk at the end of an open stream), then the cancel answers, so its worker is free. Seventeen withdrawals in a row, one more than a channel's request workers, are never refused channel_busy. The Python unit tests pin the timing (no virtual time passes); this scenario pins the wire shape and order.",
  "role": "logs",
  "transports": [
    "stdio"
  ],
  "steps": [
    {
      "dir": "c2s",
      "frame": {
        "type": "hello",
        "request_id": "h",
        "deadline_ms": 10000,
        "client_versions": [
          1,
          1
        ],
        "features": [
          "logs",
          "logs_cancel"
        ],
        "app_version": "conformance"
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "hello",
        "request_id": "h",
        "protocol_version": 1,
        "features": [
          "logs",
          "logs_cancel"
        ]
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "logs.read",
        "request_id": "f0",
        "deadline_ms": 30000,
        "instance_id": "0123456789ab",
        "stream_id": "000001",
        "start": {
          "offset": 66
        },
        "max_bytes": 65536,
        "wait_ms": 25000
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "logs.cancel",
        "request_id": "c0",
        "deadline_ms": 10000,
        "read_id": "f0"
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "logs.read",
        "request_id": "f0",
        "chunk": {
          "offset": 66,
          "data": "",
          "next_offset": 66,
          "eof": true,
          "closed": false,
          "truncated_before": false,
          "pipes": []
        }
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "logs.cancel",
        "request_id": "c0",
        "read_id": "f0"
