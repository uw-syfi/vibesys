{
  "id": "helper-feature-gated",
  "protocol": "host-helper",
  "title": "A gated method needs its feature",
  "description": "After a hello that negotiated no features, every feature-gated method, and run.start with a feature-gated field set, is answered feature_not_negotiated.",
  "role": "control",
  "transports": [
    "stdio"
  ],
  "steps": [
    {
      "dir": "c2s",
      "frame": {
        "type": "hello",
        "request_id": "h",
        "deadline_ms": 10000,
        "client_versions": [
          1,
          1
        ],
        "features": [],
        "app_version": "conformance"
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "hello",
        "request_id": "h",
        "protocol_version": 1,
        "features": []
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "instances.watch",
        "request_id": "w",
        "deadline_ms": 10000
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "w",
        "code": "feature_not_negotiated"
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "instances.unwatch",
        "request_id": "u",
        "deadline_ms": 10000,
        "watch_id": "w"
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "u",
        "code": "feature_not_negotiated"
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "instances.inspect",
        "request_id": "i",
        "deadline_ms": 10000,
        "instance_id": "0123456789ab",
        "include_log": false
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "i",
        "code": "feature_not_negotiated"
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "paths.complete",
        "request_id": "c",
        "deadline_ms": 10000,
        "prefix": "/"
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "c",
        "code": "feature_not_negotiated"
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "harnesses.list",
        "request_id": "l",
        "deadline_ms": 10000
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "l",
        "code": "feature_not_negotiated"
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "run.start",
        "request_id": "s",
        "deadline_ms": 10000,
        "project": "/nonexistent/vibesys-conformance-project",
        "harness": {
          "provider": "codex",
          "model": "gpt-5.5"
        }
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "s",
        "code": "feature_not_negotiated"
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "logs.list",
        "request_id": "ll",
        "deadline_ms": 10000,
        "instance_id": "0123456789ab"
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "ll",
        "code": "feature_not_negotiated"
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "logs.read",
        "request_id": "lr",
        "deadline_ms": 10000,
        "instance_id": "0123456789ab",
        "stream_id": "000001",
        "start": {
          "tail_bytes": 1024
        },
        "max_bytes": 65536,
        "wait_ms": 0
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "lr",
        "code": "feature_not_negotiated"
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "runs.events_for_span",
        "request_id": "es",
        "deadline_ms": 10000,
        "project": "/nonexistent/vibesys-conformance-project",
        "run_id": "20261010-120000-11111111-run",
        "span_id": "op:turn",
        "max": 10
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "es",
        "code": "feature_not_negotiated"
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "runs.read_tail",
        "request_id": "rt",
        "deadline_ms": 10000,
        "project": "/nonexistent/vibesys-conformance-project",
        "run_id": "20261010-120000-11111111-run",
        "tail": 10
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "rt",
        "code": "feature_not_negotiated"
      }
    }
  ]
}
