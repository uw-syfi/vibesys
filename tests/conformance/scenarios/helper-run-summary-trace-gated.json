{
  "id": "helper-run-summary-trace-gated",
  "protocol": "host-helper",
  "title": "runs.summary needs the run trace feature",
  "description": "After a hello that negotiated run_summary but not run_trace (a client from before the reply named its trace), runs.summary is answered feature_not_negotiated, and nothing is read.",
  "role": "control",
  "transports": [
    "stdio"
  ],
  "steps": [
    {
      "dir": "c2s",
      "frame": {
        "type": "hello",
        "request_id": "h",
        "deadline_ms": 10000,
        "client_versions": [
          1,
          1
        ],
        "features": [
          "run_summary"
        ],
        "app_version": "conformance"
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "hello",
        "request_id": "h",
        "protocol_version": 1,
        "features": [
          "run_summary"
        ]
      }
    },
    {
      "dir": "c2s",
      "frame": {
        "type": "runs.summary",
        "request_id": "m",
        "deadline_ms": 10000,
        "project": "/nonexistent-vibesys-conformance/project",
        "run_id": "20261010-120000-11111111-run",
        "offset": 0
      }
    },
    {
      "dir": "s2c",
      "expect": {
        "type": "error",
        "request_id": "m",
        "code": "feature_not_negotiated"
      }
    }
  ]
}
