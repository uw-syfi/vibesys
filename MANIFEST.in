# Include every build helper needed by the isolated PEP 517 environment.
include setup.py
include packaging_support.py
include resources_packaging.py
include tui_packaging.py
include release_versions.py
include wheel_targets.py
include third_party/bun/LICENSE

# Include the Python package roots owned by the root distribution.
graft src
graft libs/vs-evaluator-protocol/src
graft libs/vs-correctness/src
graft libs/vs-feature-flags/src
graft libs/vs-github/src
graft libs/vs-issue-board/src
graft libs/vs-loop-state/src
graft libs/vs-project/src
graft libs/vs-sandbox/src

# Include every TypeScript client package in the sdist for development source builds.
# Exclude generated and installed artifacts.
include package.json
include pnpm-lock.yaml
include pnpm-workspace.yaml
include biome.json
include tsconfig.architecture.json
include .dependency-cruiser.cjs
include scripts/check_ts_architecture.test.mjs
include scripts/check_ts_package_manifests.mjs
graft clients/backend-client/src
include clients/backend-client/package.json
include clients/backend-client/tsconfig.json
include clients/backend-client/tsconfig.check.json
include clients/backend-client/README.md
graft clients/core-state/src
include clients/core-state/package.json
include clients/core-state/tsconfig.json
include clients/core-state/tsconfig.check.json
include clients/core-state/README.md
graft clients/tui/src
include clients/tui/package.json
include clients/tui/tsconfig.json
include clients/tui/tsconfig.check.json
include clients/tui/README.md
prune clients/tui/dist
prune clients/tui/node_modules
prune clients/backend-client/dist
prune clients/backend-client/node_modules
prune clients/core-state/dist
prune clients/core-state/node_modules
prune src/*.egg-info
prune libs/*/src/*.egg-info

# Include the resource trees so a source build can stage them into
# vibesys/_resources. Vendored skill repo checkouts stay out of the sdist.
graft resources/evaluators
graft resources/profilers
graft resources/skills
prune resources/evaluators/queue/native_runner/target
prune resources/skills/serving-systems/repos

# Bundle the installable input SDK source without its tests or local artifacts.
include sdk/vs-bench/pyproject.toml
include sdk/vs-bench/README.md
graft sdk/vs-bench/src
prune sdk/vs-bench/tests
prune sdk/vs-bench/src/*.egg-info
global-exclude __pycache__ *.pyc
