# Copy to .env. VibeSys loads this file automatically when it reads agent.toml.
# Leave provider variables blank unless the selected CLI provider needs them.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional — needed for gated HuggingFace models or model downloads. On Modal,
# this can be used to populate a model Volume on the first --modal run.
HF_TOKEN=

# Optional key for the Gemini CLI provider.
GEMINI_API_KEY=

# CLI-backed agents authenticate through their own CLIs (for example, `codex
# login`); their credentials do not belong in this template.
