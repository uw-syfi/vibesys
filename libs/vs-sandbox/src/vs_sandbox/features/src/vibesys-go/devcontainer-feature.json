{
  "id": "vibesys-go",
  "version": "0.1.0",
  "name": "VibeSys Go toolchain",
  "description": "The pinned Go toolchain under /usr/local/go, readable by every user. Debian/Ubuntu bases only.",
  "documentationURL": "https://github.com/uw-syfi/vibesys/blob/main/docs/contributing/devcontainer-features.md",
  "options": {
    "go_version": {
      "type": "string",
      "default": "1.23.12",
      "description": "Go toolchain version; default mirrors vs_agent.provider_policy.GO_TOOLCHAIN_VERSION."
    }
  },
  "containerEnv": {
    "PATH": "/usr/local/go/bin:${PATH}"
  }
}
