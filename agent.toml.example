[model]
name = "gpt-5.4"
# Choose a model supported by the selected CLI provider or API backend.
# provider = "vertex-ai"    # vertex-ai, anthropic, google-genai (auto-detected if omitted)

# [thinking]
# level = "medium"          # minimal, low, medium, high (Gemini 3+ models)
# budget = 1024             # token budget (Gemini 2.5 models, -1 for dynamic)

# [providers.vertex-ai]
# json = "~/keys/vertex.json"
# project = "my-project"
# region = "us-east5"

# [providers.anthropic]
# uses ANTHROPIC_API_KEY env var

# [providers.google-genai]
# uses GOOGLE_API_KEY env var

# [agent]
# Selects the agent backend used by the outer loops. The default is "cli",
# which drives an external coding-agent CLI (Claude Code, Gemini, Codex, or
# Opencode) through vibesys/agents. Set backend = "deepagents" to use the
# LangChain/deepagents runner instead.
#
# CLI flags --agent-backend / --cli-provider on `./vs` override these values.
# backend = "cli"             # or "deepagents"
# cli_provider = "codex"      # used when backend = "cli";
                              # one of: claude, gemini, codex, opencode
# cli_timeout = 1800          # per-invocation timeout in seconds

[repository]
# Optional GitHub user or organization override. If omitted, use the account
# authenticated with `gh auth login`.
# owner = "your-github-user"
visibility = "private"       # private, public, or internal

# [tui]
# Theme for the interactive client, as light/dark pairs:
#   "dark" (default) / "light"                            — the baseline palette
#   "solarized-dark" / "solarized-light"                  — low-glare terminal palette
#   "catppuccin-mocha" / "catppuccin-latte"               — softer, more expressive
#   "high-contrast-dark" / "high-contrast-light"          — accessibility-focused
#
# The --theme flag overrides this value, and /theme switches for the current
# session without changing the file. Ignored in headless mode.
# theme = "dark"

# [feature_flags]
# VibeSys feature flags are declared in src/vibesys/features.py.

# [backend]
# Hardware/runtime backend to target. Supported values are "cuda", "metal",
# "trainium", "rocm", and "cpu". The --backend flag on `./vs` overrides this
# value.
#
# name = "cuda"
