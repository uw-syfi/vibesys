[model]
name = "gpt-6.1-sol"
# Choose a model available to your account and installed CLI provider.
# Verify it with a direct CLI request before launching VibeSys; see README.md.

# [thinking]
# level = "medium"          # minimal, low, medium, high (Gemini 3+ models)
# budget = 1024             # token budget (Gemini 2.5 models, -1 for dynamic)

# [agent]
# Selects the agent backend used by the outer loops. The default is "cli",
# which drives an external coding-agent CLI (Claude Code, Gemini, Codex, or
# Opencode) through vibesys/agents.
#
# CLI flags --agent-backend / --cli-provider on `./vs` override these values.
# backend = "cli"
# cli_provider = "codex"      # used when backend = "cli";
# one of: claude, gemini, codex, opencode
# cli_timeout = 1800          # per-invocation timeout in seconds

# [agent.quota]
# What the run does when a provider runs out of quota or is rate limited for
# long enough that waiting inside the turn did not help. The run never silently
# switches provider mid-turn. Unknown keys are an error.
#   policy = "pause"  (default) pause the run and wait for the operator to resume it.
#   policy = "wait"   pause, then resume by itself when capacity should be back
#                     (the provider's reported reset time, else every retry_seconds),
#                     for at most wait_seconds per turn (no limit when omitted);
#                     after that the turn fails with the quota error.
#   policy = "fail"   do not pause: the turn fails with the quota error at once.
#   policy = "fallback"  wait like "wait" (not at all without wait_seconds), then switch the
#                     run to fallback_provider / fallback_model. The turn in flight ends with
#                     the quota error (a session cannot change provider, and a hypothesis is
#                     never continued on another model); sessions opened afterwards are fresh
#                     conversations on the fallback, and the switch is journaled.
# Any policy may name a fallback; an operator can then resume a paused run with it.
# policy = "fallback"
# wait_seconds = 14400       # positive integer seconds; only with "wait" or "fallback"
# retry_seconds = 300        # seconds between attempts when no reset time is known
# fallback_provider = "codex"   # claude | codex | gemini | opencode; not the run's own provider
# fallback_model = "gpt-5.4"    # needs fallback_provider, and the reverse

# [evaluation]
# Added to declared stage execution budgets to bound evaluation suspension.
# queue_allowance_seconds = 900  # positive integer seconds; default 15 minutes
# How often the core polls a running evaluation job, and the longest poll delay
# after the job's state could not be read (at least the interval).
# observe_interval_seconds = 10
# observe_backoff_cap_seconds = 120

# [run]
# Optional wall-clock budget for one run. Omitted means unbounded (the round
# budget still applies).
# max_run_seconds = 86400  # positive integer seconds

[repository]
# Optional GitHub user or organization override. If omitted, use the account
# authenticated with `gh auth login`.
# owner = "your-github-user"
visibility = "private"  # private, public, or internal

# [tui]
# Theme for the interactive client, as light/dark pairs:
#   "dark" (default) / "light"                            — the baseline palette
#   "solarized-dark" / "solarized-light"                  — low-glare terminal palette
#   "catppuccin-mocha" / "catppuccin-latte"               — softer, more expressive
#   "high-contrast-dark" / "high-contrast-light"          — accessibility-focused
#
# The --theme flag overrides this value, and /theme switches for the current
# session without changing the file. Ignored in headless mode.
# theme = "dark"

# [backend]
# Hardware/runtime backend to target. Supported values are "cuda", "metal",
# "trainium", "rocm", and "cpu". The --backend flag on `./vs` overrides this
# value.
#
# name = "cuda"
