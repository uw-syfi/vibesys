{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "root": "..",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      ".dependency-cruiser.mjs",
      "**/*.ts",
      "**/*.tsx",
      "**/*.cts",
      "**/*.mts",
      "tools/scripts/**/*.mjs",
      "libs/proto/**/*.mjs",
      "libs/ui/src/**/*.css",
      "!libs/ui/src/tokens.css",
      "!**/dist",
      "!libs/display-names/src/generated",
      "!libs/proto/src/generated",
      "!libs/orchestrator-proto/src/generated",
      "!apps/desktop/src/state/new-run/generated"
    ]
  },
  "css": {
    "formatter": { "enabled": false }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "plugins": [
    "./tools/lint-rules/no-raw-html-sinks.grit",
    "./tools/lint-rules/no-pixel-snapshots.grit"
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 80, "skipBlankLines": true }
        },
        "useMaxParams": {
          "level": "error",
          "options": { "max": 6 }
        }
      },
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noGlobalEval": "error"
      },
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 2000 }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/desktop/src/state/orchestrator/search*.ts",
        "apps/desktop/src/state/orchestrator/views.ts",
        "apps/desktop/src/state/orchestrator/fold.ts",
        "apps/desktop/src/ui/orchestrator/search-panels.tsx",
        "!**/*.test.ts"
      ],
      "plugins": ["./tools/lint-rules/no-argsjson-in-fact-code.grit"]
    },
    {
      "includes": [
        "apps/**/src/**/*.ts",
        "apps/**/src/**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "plugins": [
        "./tools/lint-rules/strict-no-raw-elements.grit",
        "./tools/lint-rules/strict-no-raw-values.grit"
      ]
    },
    {
      "includes": [
        "libs/ui/src/**/*.ts",
        "libs/ui/src/**/*.tsx",
        "!libs/ui/src/tokens/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "plugins": ["./tools/lint-rules/strict-no-raw-values.grit"]
    },
    {
      "includes": [
        "libs/ui/src/**/*.css",
        "!libs/ui/src/tokens.css",
        "!libs/ui/src/primitives.css"
      ],
      "plugins": ["./tools/lint-rules/ui-no-raw-css-values.grit"]
    },
    {
      "includes": [
        "**/ui/**/*.ts",
        "**/ui/**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!libs/ui/scripts/**"
      ],
      "plugins": [
        "./tools/lint-rules/ui-no-io-calls.grit",
        "./tools/lint-rules/ui-no-effect-hooks.grit",
        "./tools/lint-rules/ui-no-io-imports.grit"
      ]
    },
    {
      "includes": [
        "apps/*/src/**/*.ts",
        "apps/*/src/**/*.tsx",
        "libs/*/src/**/*.ts",
        "libs/*/src/**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/generated/**",
        "!**/testing/**"
      ],
      "plugins": ["./tools/lint-rules/no-role-words.grit"]
    },
    {
      "includes": ["**/ui/**/*.ts", "**/ui/**/*.tsx", "!**/*.test.ts", "!**/*.test.tsx"],
      "plugins": ["./tools/lint-rules/ui-no-timers.grit"]
    },
    {
      "includes": [
        "apps/desktop/src/**/*.ts",
        "apps/desktop/src/**/*.tsx",
        "apps/desktop/src/**/*.cts"
      ],
      "plugins": ["./tools/lint-rules/effect-namespace-imports.grit"]
    },
    {
      "includes": [
        "apps/desktop/src/**/*.test.ts",
        "apps/desktop/src/**/*.test.tsx",
        "apps/desktop/src/testing/**/*.ts",
        "apps/desktop/src/testing/**/*.tsx",
        "!apps/desktop/src/testing/dom/app-builders.ts"
      ],
      "plugins": ["./tools/lint-rules/no-full-app-literals.grit"]
    },
    {
      "includes": [
        "apps/desktop/src/**/*.ts",
        "apps/desktop/src/**/*.tsx",
        "!apps/desktop/src/main/index.ts",
        "!apps/desktop/src/ui/main.tsx",
        "!apps/desktop/src/testing/page/main.tsx"
      ],
      "plugins": ["./tools/lint-rules/effect-run-only-in-entries.grit"]
    },
    {
      "includes": [
        "apps/desktop/src/core/**/*.ts",
        "apps/desktop/src/state/**/*.ts",
        "apps/desktop/src/ui/**/*.ts",
        "apps/desktop/src/ui/**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "plugins": ["./tools/lint-rules/effect-no-ambient-time-random.grit"]
    },
    {
      "includes": ["apps/desktop/src/core/**/*.ts"],
      "plugins": ["./tools/lint-rules/effect-core-no-promises.grit"]
    },
    {
      "includes": ["apps/desktop/src/**/*.test.ts", "apps/desktop/src/**/*.test.tsx"],
      "plugins": ["./tools/lint-rules/effect-tests-no-real-time.grit"]
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": { "maxLines": 10000 }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded",
      "bracketSpacing": false,
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
