{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "root": "..",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      ".dependency-cruiser.mjs",
      "**/*.ts",
      "**/*.tsx",
      "scripts/**/*.mjs",
      "!**/dist",
      "!backend-client/src/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 80, "skipBlankLines": true }
        },
        "useMaxParams": {
          "level": "error",
          "options": { "max": 6 }
        }
      },
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noGlobalEval": "error"
      },
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 2000 }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/ui/**/*.ts", "**/ui/**/*.tsx", "!**/*.test.ts", "!**/*.test.tsx"],
      "plugins": [
        "./lint-rules/ui-no-io-calls.grit",
        "./lint-rules/ui-no-effect-hooks.grit",
        "./lint-rules/ui-no-io-imports.grit"
      ]
    },
    {
      "includes": [
        "**/ui/**/*.ts",
        "**/ui/**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!tui/src/ui/activity-bar.ts",
        "!tui/src/ui/agent-map.ts",
        "!tui/src/ui/chat-composer.ts",
        "!tui/src/ui/experiment-log.ts",
        "!tui/src/ui/round-rail.ts"
      ],
      "plugins": ["./lint-rules/ui-no-timers.grit"]
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": { "maxLines": 10000 }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded",
      "bracketSpacing": false,
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
