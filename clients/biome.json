{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "root": "..",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      ".dependency-cruiser.mjs",
      "**/*.ts",
      "**/*.tsx",
      "**/*.cts",
      "**/*.mts",
      "tools/scripts/**/*.mjs",
      "libs/proto/**/*.mjs",
      "libs/ui/src/**/*.css",
      "!libs/ui/src/tokens.css",
      "!**/dist",
      "!libs/contracts/src/generated",
      "!libs/proto/src/generated"
    ]
  },
  "css": {
    "formatter": { "enabled": false }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "plugins": ["./tools/lint-rules/no-raw-html-sinks.grit"],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 80, "skipBlankLines": true }
        },
        "useMaxParams": {
          "level": "error",
          "options": { "max": 6 }
        }
      },
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noGlobalEval": "error"
      },
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 2000 }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "features/**/src/**/*.ts",
        "features/**/src/**/*.tsx",
        "apps/**/src/**/*.ts",
        "apps/**/src/**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "plugins": [
        "./tools/lint-rules/strict-no-raw-elements.grit",
        "./tools/lint-rules/strict-no-raw-values.grit"
      ]
    },
    {
      "includes": [
        "libs/ui/src/**/*.ts",
        "libs/ui/src/**/*.tsx",
        "!libs/ui/src/tokens/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "plugins": ["./tools/lint-rules/strict-no-raw-values.grit"]
    },
    {
      "includes": [
        "libs/ui/src/**/*.css",
        "!libs/ui/src/tokens.css",
        "!libs/ui/src/primitives.css"
      ],
      "plugins": ["./tools/lint-rules/ui-no-raw-css-values.grit"]
    },
    {
      "includes": [
        "**/ui/**/*.ts",
        "**/ui/**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!libs/ui/scripts/**"
      ],
      "plugins": [
        "./tools/lint-rules/ui-no-io-calls.grit",
        "./tools/lint-rules/ui-no-effect-hooks.grit",
        "./tools/lint-rules/ui-no-io-imports.grit"
      ]
    },
    {
      "includes": ["**/ui/**/*.ts", "**/ui/**/*.tsx", "!**/*.test.ts", "!**/*.test.tsx"],
      "plugins": ["./tools/lint-rules/ui-no-timers.grit"]
    },
    {
      "includes": [
        "features/*/src/**/state/**/*.ts",
        "features/*/src/**/state/**/*.tsx",
        "features/*/src/**/effects/**/*.ts",
        "features/*/src/**/effects/**/*.tsx",
        "libs/connection/src/state/**/*.ts",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "plugins": ["./tools/lint-rules/features-no-hand-rolled-control.grit"]
    },
    {
      "includes": [
        "features/run-control/src/**/*.ts",
        "features/run-control/src/**/*.tsx",
        "libs/run-session/src/**/*.ts",
        "!libs/run-session/src/run.ts",
        "libs/connection/src/**/*.ts",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "plugins": ["./tools/lint-rules/control-state-no-store-kernel.grit"]
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": { "maxLines": 10000 }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded",
      "bracketSpacing": false,
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
