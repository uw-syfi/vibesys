// A test's verdict never depends on elapsed time (docs/contributing/clients-architecture.md,
// "Testing"). Time is `TestClock` (`it.effect` provides it), so a test advances it and observes the
// outcome; it never waits, polls, retries or sets its own timeout. `it.live` and `it.scopedLive`
// run on the real clock, `it.flakyTest` retries until a flaky test passes, and
// `vi.waitFor` / `expect.poll` poll until a deadline: each is a verdict that depends on timing.
language js;

or {
  `Date.now()`,
  `new Date()`,
  `performance.now()`,
  `Math.random()`,
  `crypto.randomUUID()`,
  `globalThis.setTimeout`,
  `globalThis.setInterval`,
  JsIdentifierExpression(name = `setTimeout`),
  JsIdentifierExpression(name = `setInterval`),
  `it.live`,
  `it.scopedLive`,
  `it.flakyTest`,
  `vi.waitFor`,
  `vi.useFakeTimers`,
  `vi.setSystemTime`,
  `expect.poll`,
  JsPropertyObjectMember(name = r"(?:timeout|retry|repeats)")
} as $reference where {
  register_diagnostic(
    span = $reference,
    message = "A test uses no wall clock, polling, timeout or retry. Use it.effect with TestClock.adjust / TestRandom, and assert the state after each step.",
    severity = "error"
  )
}
