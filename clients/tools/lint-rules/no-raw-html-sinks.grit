// The gateway CSP in src/server/transport/websocket.py forbids inline script. Raw HTML sinks
// bypass React's escaping and can turn model- or tool-produced text into executable markup.
language js;

or {
  `$element.innerHTML = $_`,
  `$element.innerHTML += $_`,
  `$element.innerHTML &&= $_`,
  `$element.innerHTML ||= $_`,
  `$element.innerHTML ??= $_`,
  `$element["innerHTML"] = $_`,
  `$element["innerHTML"] += $_`,
  `$element["innerHTML"] &&= $_`,
  `$element["innerHTML"] ||= $_`,
  `$element["innerHTML"] ??= $_`,
  `$element.outerHTML = $_`,
  `$element.outerHTML += $_`,
  `$element.outerHTML &&= $_`,
  `$element.outerHTML ||= $_`,
  `$element.outerHTML ??= $_`,
  `$element["outerHTML"] = $_`,
  `$element["outerHTML"] += $_`,
  `$element["outerHTML"] &&= $_`,
  `$element["outerHTML"] ||= $_`,
  `$element["outerHTML"] ??= $_`,
  `$element.insertAdjacentHTML($args)`,
  `$element.insertAdjacentHTML?.($args)`,
  `$element?.insertAdjacentHTML($args)`,
  `$element?.insertAdjacentHTML?.($args)`,
  `$element["insertAdjacentHTML"]($args)`,
  `$element["insertAdjacentHTML"]?.($args)`,
  `$element?.["insertAdjacentHTML"]($args)`,
  `$element?.["insertAdjacentHTML"]?.($args)`,
  `document.write($args)`,
  `document.write?.($args)`,
  `document?.write($args)`,
  `document?.write?.($args)`,
  `document["write"]($args)`,
  `document["write"]?.($args)`,
  `document?.["write"]($args)`,
  `document?.["write"]?.($args)`,
  `window.document.write($args)`,
  `window.document.write?.($args)`,
  `window.document?.write($args)`,
  `window.document?.write?.($args)`,
  `window.document["write"]($args)`,
  `window.document["write"]?.($args)`,
  `window.document?.["write"]($args)`,
  `window.document?.["write"]?.($args)`,
  `window?.document.write($args)`,
  `window?.document.write?.($args)`,
  `window?.document?.write($args)`,
  `window?.document?.write?.($args)`,
  `window?.document["write"]($args)`,
  `window?.document["write"]?.($args)`,
  `window?.document?.["write"]($args)`,
  `window?.document?.["write"]?.($args)`,
  `globalThis.document.write($args)`,
  `globalThis.document.write?.($args)`,
  `globalThis.document?.write($args)`,
  `globalThis.document?.write?.($args)`,
  `globalThis.document["write"]($args)`,
  `globalThis.document["write"]?.($args)`,
  `globalThis.document?.["write"]($args)`,
  `globalThis.document?.["write"]?.($args)`,
  `globalThis?.document.write($args)`,
  `globalThis?.document.write?.($args)`,
  `globalThis?.document?.write($args)`,
  `globalThis?.document?.write?.($args)`,
  `globalThis?.document["write"]($args)`,
  `globalThis?.document["write"]?.($args)`,
  `globalThis?.document?.["write"]($args)`,
  `globalThis?.document?.["write"]?.($args)`
} as $sink where {
  register_diagnostic(
    span = $sink,
    message = "Raw HTML sinks bypass the gateway CSP contract. Render text or structured data instead.",
    severity = "error"
  )
}
