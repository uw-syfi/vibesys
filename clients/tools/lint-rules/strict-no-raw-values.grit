// Rules S4 and S8 of the desktop design system (docs/contributing/clients-architecture.md,
// "Design system enforcement"). Features, apps, and `@vibesys/ui`'s own source outside its token
// table (`src/tokens/`), name colors and lengths only through tokens: a string or template literal
// holding a hex color, `rgb(`, `rgba(`, `hsl(`, `hsla(`, `oklch(`, `color-mix(`, or a CSS length
// (`<number>px`, `rem`, `em`, `vh`, `vw`) is an error. `ui-no-raw-css-values.grit` is the same rule
// for `@vibesys/ui`'s stylesheets. biome.json applies this rule to every feature and app source.
//
// A Grit regex must match the whole text, hence the `.*` on both sides; `(?s)` lets a template
// chunk span lines. A length is a number that does not continue an identifier (`v1px`) or a longer
// number, and a hex color has 3, 4, 6 or 8 digits.
language js;

or {
  JsStringLiteralExpression(),
  JsTemplateChunkElement(),
  JsxString()
} as $literal where {
  $literal <: r"(?s).*(?:(?:^|[^\w.#])\d*\.?\d+(?:px|rem|em|vh|vw)\b|#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})\b|\b(?:rgba?|hsla?|oklch|color-mix)\().*",
  register_diagnostic(
    span = $literal,
    message = "strict-no-raw-values (S4, S8): a raw color or CSS length in a string. Name it through a token instead: a `SpaceToken` such as '4' or a `Tone` on a component, or a `var(--...)` from the token table in `@vibesys/ui/tokens`. A value the table lacks is added to the table in `@vibesys/ui`, not written here.",
    severity = "error"
  )
}
