{
  // The Electron main process and its preloads, emitted to `dist` (the package `main`).
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The preloads use the DOM's MessagePort and window, so this keeps the DOM library the
    // main build has always had.
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.cts"],
  "exclude": ["src/**/*.test.ts", "src/testing/**", "src/welcome/**"],
  "references": [
    {"path": "../backend-client/tsconfig.lib.json"},
    {"path": "../core-state/tsconfig.lib.json"}
  ]
}
