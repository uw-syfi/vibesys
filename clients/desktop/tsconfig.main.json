{
  // The Electron main process and its preloads, emitted to `dist` (the package `main`).
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The preloads use the DOM's MessagePort and window, so this keeps the DOM library the
    // main build has always had.
    "lib": ["ES2022", "DOM", "esnext.disposable"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.cts"],
  "exclude": ["src/**/*.test.ts", "src/**/testing/**", "src/renderer/welcome/**", "src/renderer/index.ts"],
  "references": [
    {"path": "../transport/tsconfig.lib.json"},
    {"path": "../contracts/tsconfig.lib.json"},
    {"path": "../core-state/tsconfig.lib.json"},
    {"path": "../entities/tsconfig.lib.json"},
    {"path": "../ipc/tsconfig.lib.json"}
  ]
}
