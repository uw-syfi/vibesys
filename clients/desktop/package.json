{
  "name": "@vibesys/desktop",
  "productName": "VibeSys",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "vibesys": {
    "layer": "app",
    "entries": {
      ".": "node",
      "./preload/run": "node",
      "./preload/welcome": "node"
    }
  },
  "main": "dist/main/index.js",
  "exports": {
    ".": {
      "@vibesys/source": "./src/main/index.ts",
      "default": "./dist/main/index.js"
    },
    "./preload/run": {
      "@vibesys/source": "./src/renderer/preload/run.cts",
      "default": "./dist/renderer/preload/run.cjs"
    },
    "./preload/welcome": {
      "@vibesys/source": "./src/renderer/preload/welcome.cts",
      "default": "./dist/renderer/preload/welcome.cjs"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.main.json && node scripts/copy-ui.mjs",
    "check": "tsc -b",
    "test": "node ../scripts/run_bun_tests.mjs ./src",
    "start": "pnpm build && electron ."
  },
  "dependencies": {
    "@vibesys/contracts": "workspace:*",
    "@vibesys/entities": "workspace:*",
    "@vibesys/ipc": "workspace:*",
    "@vibesys/transport": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^24.0.0",
    "@vibesys/core-state": "workspace:*",
    "electron": "44.6.0",
    "typescript": "^5.8.3"
  }
}
