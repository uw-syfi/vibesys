{
  "name": "@vibesys/desktop",
  "productName": "VibeSys",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "vibesys": {
    "layer": "app",
    "entries": {
      ".": "node"
    }
  },
  "main": "dist/main/app/main.js",
  "exports": {},
  "scripts": {
    "build": "tsc -b tsconfig.main.json && vite build --config vite.welcome.config.ts && node scripts/copy-ui.mjs",
    "check": "tsc -b && tsc -p tsconfig.welcome.json",
    "test": "node ../scripts/run_bun_tests.mjs ./src",
    "start": "pnpm build && electron ."
  },
  "dependencies": {
    "@vibesys/transport": "workspace:*",
    "@vibesys/contracts": "workspace:*",
    "@vibesys/core-state": "workspace:*",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.6.0",
    "typescript": "^5.8.3"
  }
}
