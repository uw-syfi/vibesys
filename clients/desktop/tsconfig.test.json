{
  // Tests and their fakes, with the main-process and welcome-state sources they import.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "esnext.disposable"],
    "types": ["node", "bun"],
    "noEmit": true,
    "tsBuildInfoFile": ".tsbuild/test.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.cts"],
  "references": [
    {"path": "../transport/tsconfig.lib.json"},
    {"path": "../transport/tsconfig.testing.json"},
    {"path": "../contracts/tsconfig.lib.json"},
    {"path": "../core-state/tsconfig.lib.json"}
  ]
}
