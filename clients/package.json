{
  "name": "vibesys-workspace",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "format:ts": "biome format --write .",
    "check:format:ts": "biome format .",
    "lint:ts": "biome lint .",
    "check:ts": "biome check . && pnpm warn:ts-file-size",
    "warn:ts-file-size": "biome lint --config-path biome.warnings.json --only=style/noExcessiveLinesPerFile .",
    "check:ts-architecture": "node tools/scripts/check_ts_architecture.mjs && node tools/scripts/check_package_graph.mjs",
    "test:ts-architecture": "node --test tools/scripts/check_ts_architecture.test.mjs tools/scripts/check_package_graph.test.mjs tools/scripts/new_package.test.mjs tools/scripts/check_biome_line_caps.test.mjs tools/scripts/check_ui_no_effects.test.mjs tools/scripts/check_control_state_rules.test.mjs tools/scripts/check_raw_html_sinks.test.mjs tools/scripts/check_strict_design_lint.test.mjs tools/scripts/e2e_shard.test.mjs",
    "test:bun-runner": "node --test tools/scripts/run_bun_tests.test.mjs",
    "test:node-runner": "node --test tools/scripts/run_node_tests.test.mjs",
    "check:conformance": "node tools/scripts/check_conformance_corpus.mjs",
    "test:conformance": "node --test tools/scripts/check_conformance_corpus.test.mjs",
    "check:knip": "knip --config tools/knip.config.ts",
    "new:package": "node tools/scripts/new_package.mjs",
    "build:clients": "turbo run build",
    "check:clients": "turbo run check",
    "test:clients": "pnpm test:ts-architecture && pnpm test:conformance && pnpm test:bun-runner && pnpm test:node-runner && turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "dependency-cruiser": "16.10.4",
    "knip": "6.37.0",
    "turbo": "2.11.4",
    "typescript": "5.9.3",
    "vite": "7.1.5",
    "@bufbuild/protoc-gen-es": "2.16.0"
  }
}
