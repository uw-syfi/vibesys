{
  "name": "vibesys-workspace",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "desktop": "pnpm --filter @vibesys/desktop dev",
    "desktop:start": "pnpm --filter @vibesys/web build && pnpm --filter @vibesys/desktop start",
    "format:ts": "biome format --write .",
    "check:format:ts": "biome format .",
    "lint:ts": "biome lint .",
    "check:ts": "biome check .",
    "check:ts-architecture": "node scripts/check_ts_architecture.mjs && node scripts/check_ts_package_manifests.mjs",
    "test:ts-architecture": "node --test scripts/check_ts_architecture.test.mjs",
    "test:bun-runner": "node --test scripts/run_bun_tests.test.mjs",
    "check:conformance": "node scripts/check_conformance_corpus.mjs",
    "check:web-browser-bundle": "pnpm --filter @vibesys/web build:browser && node scripts/check_web_browser_bundle.mjs",
    "test:conformance": "node --test scripts/check_conformance_corpus.test.mjs",
    "check:knip": "knip",
    "build:clients": "pnpm -r --workspace-concurrency=1 run build",
    "check:clients": "pnpm -r --workspace-concurrency=1 run check",
    "test:clients": "pnpm test:ts-architecture && pnpm test:conformance && pnpm test:bun-runner && pnpm -r --workspace-concurrency=1 run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "dependency-cruiser": "16.10.4",
    "knip": "6.37.0",
    "vite": "7.1.5"
  }
}
