{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // External programs run by scripts or tests, not npm packages: `uv` (generate:protocol, dev
  // machines only) and `pkill` (harness.test.ts cleanup).
  "ignoreBinaries": ["uv", "pkill"],
  "workspaces": {
    ".": {
      // Repository tooling run by `node scripts/...`; `*.test.mjs` runs under `node --test`.
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "backend-client": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      // Generated by `pnpm generate:protocol` (json2ts): every schema definition is exported
      // whether or not the TUI uses it, and the file must not be edited by hand.
      "ignore": ["src/generated/**"]
    },
    "core-state": {
      "entry": ["src/**/*.test.ts", "bench/*.ts"],
      "project": ["src/**/*.ts", "bench/**/*.ts"]
    },
    "tui": {
      "entry": [
        // The frontend process: the launcher (the `bin`, an entry by default) spawns `dist/index.js`.
        "src/index.ts",
        "src/**/*.test.ts",
        // Replay harness: `mock-ui.sh` starts `mock-server.ts`; `harness.test.ts` runs under `bun test`.
        "dev/mock-server.ts",
        "dev/**/*.test.ts",
        // Hand-run benchmark (`bun benchmarks/experiment-refresh.ts`).
        "benchmarks/*.ts"
      ],
      "project": ["src/**/*.ts", "dev/**/*.ts", "benchmarks/**/*.ts"]
    },
    "web": {
      // The package's public surface. Vite (index.html -> src/main.tsx) and Playwright
      // (playwright.config.ts -> e2e/*.spec.ts) entries come from knip's plugins.
      // e2e/gateway.ts and e2e/home.ts are the harness's own public surface: specs use only part
      // of it today (the setup screens' specs, later tasks, consume the rest of home.ts).
      // home-api.ts's wire types mirror plan 2's contract.py in full; setup-UI pages (later
      // tasks) consume only part of it at a time. setup.ts and launch.ts are this task's form
      // and launch models; the SetupView task that renders them lands later and will consume
      // the rest of their surface. ui/Setup.tsx's Row and Hint serve the key and task-form rows
      // of later tasks.
      "entry": ["src/index.ts", "e2e/gateway.ts", "e2e/home.ts", "src/home-api.ts", "src/setup.ts", "src/launch.ts", "src/ui/Setup.tsx"]
    }
  }
}
