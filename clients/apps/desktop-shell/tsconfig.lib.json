{
  "extends": "../../tools/tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "tsBuildInfoFile": ".tsbuild/lib.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../../features/app-shell/tsconfig.renderer.json"
    },
    {
      "path": "../../features/machines/tsconfig.renderer.json"
    },
    {
      "path": "../../features/new-run/tsconfig.renderer.json"
    },
    {
      "path": "../../features/new-run/tsconfig.state.json"
    },
    {
      "path": "../../features/run-page/tsconfig.renderer.json"
    },
    {
      "path": "../../features/run-page/tsconfig.state.json"
    },
    {
      "path": "../../features/settings/tsconfig.renderer.json"
    },
    {
      "path": "../../features/settings/tsconfig.state.json"
    },
    {
      "path": "../../features/settings/tsconfig.state.json"
    },
    {
      "path": "../../libs/hosts/tsconfig.lib.json"
    },
    {
      "path": "../../libs/ipc/tsconfig.lib.json"
    },
    {
      "path": "../../libs/runs/tsconfig.lib.json"
    },
    {
      "path": "../../libs/store/tsconfig.lib.json"
    },
    {
      "path": "../../libs/ui/tsconfig.lib.json"
    }
  ]
}
