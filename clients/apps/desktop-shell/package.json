{
  "name": "@vibesys/app-desktop-shell",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "vibesys": {
    "layer": "app",
    "entries": {
      ".": "dom"
    }
  },
  "scripts": {
    "build": "vite build",
    "check": "tsc -b",
    "test": "node ../../tools/scripts/run_bun_tests.mjs ./src",
    "test:e2e": "pnpm build && pnpm e2e",
    "fixtures": "bun --conditions=@vibesys/source e2e/tools/regenerate-fixtures.ts",
    "e2e:linux": "bash scripts/linux-e2e.sh",
    "e2e": "node --conditions=@vibesys/source ../../node_modules/@playwright/test/cli.js test",
    "dev:fixture": "bun --conditions=@vibesys/source e2e/tools/dev-fixture.ts",
    "record": "bun --conditions=@vibesys/source e2e/tools/record-run-fixture.ts"
  },
  "dependencies": {
    "@vibesys/feature-app-shell": "workspace:*",
    "@vibesys/feature-machines": "workspace:*",
    "@vibesys/feature-new-run": "workspace:*",
    "@vibesys/feature-usage": "workspace:*",
    "@vibesys/feature-run-chat": "workspace:*",
    "@vibesys/feature-run-page": "workspace:*",
    "@vibesys/feature-runs-dashboard": "workspace:*",
    "@vibesys/feature-settings": "workspace:*",
    "@vibesys/hosts": "workspace:*",
    "@vibesys/ipc": "workspace:*",
    "@vibesys/run-session": "workspace:*",
    "@vibesys/runs": "workspace:*",
    "@vibesys/store": "workspace:*",
    "@vibesys/transport": "workspace:*",
    "@vibesys/ui": "workspace:*",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@vibesys/machine": "workspace:*",
    "@vibesys/run-skeleton": "workspace:*",
    "@vibesys/feature-run-intents": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.0",
    "@types/bun": "1.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vibesys/contracts": "workspace:*",
    "@vibesys/run-fixtures": "workspace:*",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "^5.8.3",
    "@vibesys/proto": "workspace:*",
    "@bufbuild/protobuf": "2.16.0"
  }
}
