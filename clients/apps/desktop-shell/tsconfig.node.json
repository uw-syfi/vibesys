{
  // The bundle's Vite configuration and the Playwright suite, which run under Node.
  "extends": "../../tools/tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "tsBuildInfoFile": ".tsbuild/node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "playwright.config.ts", "../../tools/e2e/bundled-fonts.mts", "../../tools/e2e/free-port.mts", "../../tools/e2e/shard.mts", "../../tools/e2e/workers.mts", "e2e/**/*.ts", "src/testing/gateway-wire.ts"],
  "references": [
    {"path": "../../libs/contracts/tsconfig.lib.json"},
    {"path": "../../libs/ipc/tsconfig.lib.json"},
    {"path": "../../libs/run-fixtures/tsconfig.lib.json"},
    {"path": "../../libs/run-fixtures/tsconfig.derived.json"},
    {"path": "../../features/new-run/tsconfig.state.json"}
  ]
}
