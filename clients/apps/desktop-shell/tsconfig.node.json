{
  // The bundle configuration, Playwright suite and test-only renderer replay.
  "extends": "../../tools/tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "tsBuildInfoFile": ".tsbuild/node.tsbuildinfo",
    "jsx": "react-jsx"
  },
  "include": ["vite.config.ts", "playwright.config.ts", "../../tools/e2e/free-port.mts", "../../tools/e2e/shard.mts", "e2e/**/*.ts", "e2e/**/*.tsx"],
  "references": [
    {"path": "../../libs/contracts/tsconfig.lib.json"},
    {"path": "../../libs/ipc/tsconfig.lib.json"},
    {"path": "../../libs/run-fixtures/tsconfig.lib.json"},
    {"path": "../../features/new-run/tsconfig.state.json"},
    {"path": "../../features/run-intents/tsconfig.renderer.json"},
    {"path": "../../features/run-page/tsconfig.renderer.json"},
    {"path": "../../libs/transport/tsconfig.testing.json"},
    {"path": "../../libs/runs/tsconfig.intents.json"}
  ]
}
