{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["transit"],
      "outputs": ["dist/**"]
    },
    "build:desktop": {
      "dependsOn": ["transit"],
      "outputs": [".desktop-dist/**"]
    },
    "build:browser": {
      "dependsOn": ["transit"],
      "outputs": [".browser-dist/**"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tui/dev/fixtures/**"]
    }
  }
}
