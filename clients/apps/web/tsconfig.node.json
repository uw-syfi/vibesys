{
  // The build and test tool configuration, which runs under Node.
  "extends": "../../tools/tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "tsBuildInfoFile": ".tsbuild/node.tsbuildinfo"
  },
  "include": [
    "build-inputs.ts",
    "campaign-stream.ts",
    "build-manifest.ts",
    "playwright.config.ts",
    "vite.config.ts",
    "vite.browser.config.ts",
    "vite.desktop.config.ts"
  ]
}
