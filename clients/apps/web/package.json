{
  "name": "@vibesys/app-web",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "vibesys": {
    "layer": "app",
    "entries": {
      ".": "dom"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:browser": "vite build --config vite.browser.config.ts",
    "build:desktop": "vite build --config vite.desktop.config.ts",
    "check": "tsc -b",
    "test": "node ../../tools/scripts/run_bun_tests.mjs ./src",
    "test:e2e": "turbo run build --filter=@vibesys/app-web... && playwright test"
  },
  "dependencies": {
    "@vibesys/contracts": "workspace:*",
    "@vibesys/feature-gateway-connect": "workspace:*",
    "@vibesys/feature-run-view": "workspace:*",
    "@vibesys/ipc": "workspace:*",
    "@vibesys/run-session": "workspace:*",
    "@vibesys/store": "workspace:*",
    "@vibesys/transport": "workspace:*",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@vibesys/feature-campaign": "workspace:*",
    "@vibesys/feature-conversation": "workspace:*",
    "@vibesys/run-state": "workspace:*",
    "@vibesys/ui": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/bun": "1.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "^5.8.3",
    "@tailwindcss/vite": "^4.3.3"
  }
}
