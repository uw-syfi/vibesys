{
  "name": "@vibesys/app-ui-gallery",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "vibesys": {
    "layer": "app",
    "entries": {
      ".": "dom"
    }
  },
  "scripts": {
    "build": "vite build",
    "check": "tsc -b",
    "dev": "vite",
    "test": "node ../../tools/scripts/run_bun_tests.mjs ./src",
    "test:e2e": "node ../../tools/scripts/with_e2e_specs.mjs ui-gallery \"pnpm build && playwright test --pass-with-no-tests\"",
    "test:e2e:linux": "bash scripts/linux-playwright.sh",
    "check:deterministic": "bash scripts/check-deterministic.sh",
    "update:screenshots": "bash scripts/linux-playwright.sh --update-snapshots"
  },
  "dependencies": {
    "@vibesys/feature-new-run": "workspace:*",
    "@vibesys/ui": "workspace:*",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.0",
    "@types/bun": "1.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "^5.8.3"
  }
}
