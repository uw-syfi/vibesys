{
  "name": "@vibesys/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.js",
  "vibesys": {
    "layer": "app",
    "entries": {
      "./main": "node",
      "./preload": "preload",
      "./core": "neutral",
      "./state": "neutral",
      "./ui": "dom"
    }
  },
  "exports": {
    "./main": {
      "@vibesys/source": "./src/main/index.ts",
      "default": "./dist/main/index.js"
    },
    "./preload": {
      "@vibesys/source": "./src/preload/index.cts",
      "default": "./dist/preload/index.cjs"
    },
    "./core": {
      "@vibesys/source": "./src/core/index.ts",
      "default": "./dist/core/index.js"
    },
    "./state": {
      "@vibesys/source": "./src/state/index.ts",
      "default": "./dist/state/index.js"
    },
    "./ui": {
      "@vibesys/source": "./src/ui/index.ts",
      "default": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.core.json tsconfig.state.json tsconfig.ui.json tsconfig.main.json tsconfig.preload.json && vite build && node scripts/build-gateway.mjs",
    "check": "tsc -b",
    "start": "pnpm build && electron .",
    "test": "node ../../tools/scripts/run_vitest.mjs ./src"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@bufbuild/protovalidate": "1.3.0",
    "@effect/atom-react": "4.1.2",
    "@vibesys/connection": "workspace:*",
    "@vibesys/contracts": "workspace:*",
    "@vibesys/hosts": "workspace:*",
    "@vibesys/ipc": "workspace:*",
    "@vibesys/orchestrator-proto": "workspace:*",
    "@vibesys/settings": "workspace:*",
    "@vibesys/transport": "workspace:*",
    "@vibesys/ui": "workspace:*",
    "effect": "4.1.2",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vibesys/proto": "workspace:*",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.6.0",
    "fast-check": "4.10.2",
    "typescript": "^5.8.3",
    "vite": "7.1.5",
    "vitest": "5.0.5"
  },
  "productName": "VibeSys"
}
