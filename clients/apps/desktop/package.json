{
  "name": "@vibesys/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "vibesys": {
    "layer": "app",
    "entries": {
      "./main": "node",
      "./preload": "preload",
      "./core": "neutral",
      "./state": "neutral",
      "./ui": "dom"
    }
  },
  "exports": {
    "./main": {
      "@vibesys/source": "./src/main/index.ts",
      "default": "./dist/main/index.js"
    },
    "./preload": {
      "@vibesys/source": "./src/preload/index.cts",
      "default": "./dist/preload/index.cjs"
    },
    "./core": {
      "@vibesys/source": "./src/core/index.ts",
      "default": "./dist/core/index.js"
    },
    "./state": {
      "@vibesys/source": "./src/state/index.ts",
      "default": "./dist/state/index.js"
    },
    "./ui": {
      "@vibesys/source": "./src/ui/index.ts",
      "default": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.core.json tsconfig.state.json tsconfig.ui.json tsconfig.main.json tsconfig.preload.json",
    "check": "tsc -b",
    "test": "node ../../tools/scripts/run_vitest.mjs ./src"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@bufbuild/protovalidate": "1.3.0",
    "@vibesys/hosts": "workspace:*",
    "@vibesys/orchestrator-proto": "workspace:*",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "5.0.5"
  }
}
