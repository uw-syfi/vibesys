{
  "extends": "../../tools/tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "jsx": "react-jsx",
    "noEmit": true,
    "tsBuildInfoFile": ".tsbuild/ui-test.tsbuildinfo"
  },
  "include": [
    "src/ui/**/*.test.ts",
    "src/ui/**/*.test.tsx",
    "src/testing/orchestrator/**/*.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.ui.json"
    },
    {
      "path": "./tsconfig.state.json"
    },
    {
      "path": "../../libs/orchestrator-proto/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "src/testing/**/*.test.ts"
  ]
}