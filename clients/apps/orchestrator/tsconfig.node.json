{
  // The bundle's Vite configuration, which runs under Node.
  "extends": "../../tools/tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "tsBuildInfoFile": ".tsbuild/node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
