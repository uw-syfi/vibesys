{
  // The welcome view's page: DOM and Vite's client types only, so a Node import is a type error.
  // Vite bundles it (`vite.config.ts`).
  "extends": "../../tools/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "tsBuildInfoFile": ".tsbuild/lib.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    {"path": "../../libs/hosts/tsconfig.lib.json"},
    {"path": "../../libs/runs/tsconfig.lib.json"},
    {"path": "../../libs/store/tsconfig.lib.json"},
    {"path": "../../libs/ipc/tsconfig.lib.json"},
    {"path": "../../libs/ui/tsconfig.lib.json"},
    {"path": "../../features/hosts/tsconfig.state.json"},
    {"path": "../../features/hosts/tsconfig.renderer.json"},
    {"path": "../../features/recent-runs/tsconfig.state.json"},
    {"path": "../../features/recent-runs/tsconfig.renderer.json"},
    {"path": "../../features/run-control/tsconfig.state.json"},
    {"path": "../../features/run-control/tsconfig.renderer.json"},
    {"path": "../../features/start-run/tsconfig.state.json"},
    {"path": "../../features/start-run/tsconfig.renderer.json"}
  ]
}
