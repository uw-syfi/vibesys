{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "esnext.disposable"
    ],
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.lib.tsbuildinfo"
  },
  "include": [
    "src/main/**/*.ts"
  ],
  "exclude": [
    "src/main/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../../connection/tsconfig.lib.json"
    },
    {
      "path": "../../settings/tsconfig.lib.json"
    },
    {
      "path": "../../features/hosts/tsconfig.main.json"
    },
    {
      "path": "../../features/run-control/tsconfig.main.json"
    },
    {
      "path": "../../features/start-run/tsconfig.state.json"
    },
    {
      "path": "../../hosts/tsconfig.lib.json"
    },
    {
      "path": "../../ipc/tsconfig.lib.json"
    },
    {
      "path": "../../runs/tsconfig.lib.json"
    },
    {
      "path": "../../transport/tsconfig.lib.json"
    }
  ]
}
