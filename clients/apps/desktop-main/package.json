{
  "name": "@vibesys/app-desktop-main",
  "productName": "VibeSys",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "vibesys": {
    "layer": "app",
    "entries": {
      ".": "node",
      "./preload-welcome": "preload"
    }
  },
  "main": "dist/main/index.js",
  "exports": {
    ".": {
      "@vibesys/source": "./src/main/index.ts",
      "default": "./dist/main/index.js"
    },
    "./preload-welcome": {
      "@vibesys/source": "./src/preload/welcome.cts",
      "default": "./dist/preload/welcome.cjs"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.lib.json tsconfig.preload-welcome.json && node scripts/copy-ui.mjs && node scripts/build-gateway.mjs",
    "check": "tsc -b",
    "test": "node ../../tools/scripts/run_bun_tests.mjs ./src",
    "test:e2e": "turbo run build --filter=@vibesys/app-desktop-main... && node e2e/verify-electron-runtime.mjs && playwright test --pass-with-no-tests",
    "start": "pnpm build && electron .",
    "dev": "pnpm start"
  },
  "dependencies": {
    "@vibesys/connection": "workspace:*",
    "@vibesys/feature-app-shell": "workspace:*",
    "@vibesys/feature-hosts": "workspace:*",
    "@vibesys/feature-machines": "workspace:*",
    "@vibesys/feature-new-run": "workspace:*",
    "@vibesys/feature-run-control": "workspace:*",
    "@vibesys/feature-settings": "workspace:*",
    "@vibesys/hosts": "workspace:*",
    "@vibesys/ipc": "workspace:*",
    "@vibesys/run-history": "workspace:*",
    "@vibesys/runs": "workspace:*",
    "@vibesys/settings": "workspace:*",
    "@vibesys/transport": "workspace:*",
    "@vibesys/ui": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/bun": "1.4.2",
    "@types/node": "^24.0.0",
    "@vibesys/store": "workspace:*",
    "electron": "44.6.0",
    "typescript": "^5.8.3",
    "@bufbuild/protobuf": "2.16.0",
    "@vibesys/proto": "workspace:*"
  }
}
