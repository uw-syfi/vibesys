{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // The main process serves the shell's bundle from `dist/ui` (`scripts/copy-ui.mjs`); it
      // consumes the renderer app only as built files, never as an import.
      "dependsOn": ["^build", "@vibesys/app-desktop-shell#build"],
      "inputs": ["$TURBO_DEFAULT$", "../../../gateway/**", "../../libs/proto/src/generated/schema-hashes.ts"],
      "outputs": ["dist/**"]
    }
  }
}
