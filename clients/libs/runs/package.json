{
  "name": "@vibesys/runs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibesys": {
    "layer": "domain",
    "entries": {
      ".": "neutral",
      "./intents": "neutral"
    }
  },
  "exports": {
    ".": {
      "@vibesys/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./intents": {
      "@vibesys/source": "./src/intents/index.ts",
      "types": "./dist/intents/index.d.ts",
      "default": "./dist/intents/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json tsconfig.intents.json",
    "check": "tsc -b",
    "test": "node ../../tools/scripts/run_bun_tests.mjs ./src"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@vibesys/store": "workspace:*",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@vibesys/contracts": "workspace:*",
    "@vibesys/hosts": "workspace:*",
    "@vibesys/proto": "workspace:*",
    "@bufbuild/protobuf": "2.16.0"
  }
}
