{
  "extends": "../../tools/tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "bun"
    ],
    "noEmit": true,
    "tsBuildInfoFile": ".tsbuild/test.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "scripts/*.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.legacy.json"
    },
    {
      "path": "./tsconfig.tokens.json"
    }
  ]
}
