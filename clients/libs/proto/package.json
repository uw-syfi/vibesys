{
  "name": "@vibesys/proto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibesys": {
    "layer": "foundation",
    "entries": {
      ".": "neutral"
    }
  },
  "exports": {
    ".": {
      "@vibesys/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.*.tsbuildinfo"
  ],
  "scripts": {
    "prepare": "node generate-schema-files.mjs",
    "build": "node generate-schema-files.mjs && tsc -b tsconfig.lib.json",
    "check": "node generate-schema-files.mjs && tsc -b",
    "test": "node generate-schema-files.mjs && tsc -b && node ../../tools/scripts/run_node_suite.mjs tests/*.test.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@bufbuild/protovalidate": "1.3.0",
    "@noble/hashes": "2.0.1"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
