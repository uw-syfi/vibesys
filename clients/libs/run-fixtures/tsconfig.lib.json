{
  "extends": "../../tools/tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "types": [],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.lib.tsbuildinfo",
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/data/*.json"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../contracts/tsconfig.lib.json"
    },
    {
      "path": "../proto/tsconfig.lib.json"
    }
  ]
}
