{
  "name": "@vibesys/orchestrator-source",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibesys": {
    "layer": "domain",
    "entries": {
      ".": "neutral",
      "./node": "node"
    }
  },
  "exports": {
    ".": {
      "@vibesys/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "@vibesys/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json tsconfig.node.json",
    "check": "tsc -b",
    "test": "node ../../tools/scripts/run_bun_tests.mjs ./src"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "^5.8.3",
    "@types/node": "^24.0.0",
    "fast-check": "4.10.2"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@vibesys/orchestrator-proto": "workspace:*"
  }
}
