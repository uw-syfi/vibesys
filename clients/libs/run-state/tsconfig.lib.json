{
  "extends": "../../tools/tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "types": [],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.lib.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/rounds/**",
    "src/performance/**",
    "src/transcript/**",
    "src/trace/**",
    "src/overview/**",
    "src/candidates/**",
    "src/agents/**",
    "src/usage/**",
    "src/records/**",
    "src/skeleton/**"
  ],
  "references": [
    {
      "path": "../contracts/tsconfig.lib.json"
    }
  ]
}
