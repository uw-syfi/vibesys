{
  "name": "@vibesys/display-names",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibesys": {
    "layer": "foundation",
    "entries": {
      ".": "neutral"
    }
  },
  "exports": {
    ".": {
      "@vibesys/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.*.tsbuildinfo",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "generate": "uv run --project ../../.. python -m vibesys.api.display_catalog src/generated/display-names.generated.ts",
    "build": "tsc -b tsconfig.lib.json",
    "check": "tsc -b",
    "test": "node ../../tools/scripts/run_bun_tests.mjs ./src"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
