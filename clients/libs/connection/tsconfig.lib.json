{
  "extends": "../../tools/tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "esnext.disposable"
    ],
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.lib.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/testing/**"
  ],
  "references": [
    {
      "path": "../contracts/tsconfig.host-helper.json"
    },
    {
      "path": "../hosts/tsconfig.lib.json"
    },
    {
      "path": "../logs/tsconfig.lib.json"
    },
    {
      "path": "../machine/tsconfig.lib.json"
    },
    {
      "path": "../transport/tsconfig.lib.json"
    },
    {
      "path": "../proto/tsconfig.lib.json"
    }
  ]
}
