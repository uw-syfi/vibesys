{
  "name": "@vibesys/connection",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibesys": {
    "layer": "service",
    "entries": {
      ".": "node",
      "./testing": "node"
    }
  },
  "exports": {
    ".": {
      "@vibesys/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@vibesys/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json tsconfig.testing.json",
    "check": "tsc -b",
    "test": "pnpm test:bun && pnpm test:node",
    "test:bun": "node ../../tools/scripts/run_bun_tests.mjs ./src",
    "test:node": "pnpm build && node ../../tools/scripts/run_node_tests.mjs ./node-tests"
  },
  "dependencies": {
    "@vibesys/contracts": "workspace:*",
    "@vibesys/hosts": "workspace:*",
    "@vibesys/logs": "workspace:*",
    "@vibesys/machine": "workspace:*",
    "@vibesys/transport": "workspace:*",
    "xstate": "5.33.2",
    "@vibesys/proto": "workspace:*",
    "@bufbuild/protobuf": "2.16.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "@vibesys/store": "workspace:*",
    "expect": "30.5.2"
  }
}
