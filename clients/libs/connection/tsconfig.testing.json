{
  "extends": "../../tools/tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "esnext.disposable"
    ],
    "types": [
      "node",
      "bun"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.testing.tsbuildinfo"
  },
  "include": [
    "src/testing/**/*.ts"
  ],
  "exclude": [
    "src/testing/**/*.test.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "../contracts/tsconfig.host-helper.json"
    },
    {
      "path": "../subscription/tsconfig.lib.json"
    },
    {
      "path": "../subscription/tsconfig.testing.json"
    }
  ]
}
