{
  "name": "@vibesys/tui",
  "version": "0.1.1",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uw-syfi/vibesys.git"
  },
  "bugs": {
    "url": "https://github.com/uw-syfi/vibesys/issues"
  },
  "type": "module",
  "vibesys": {
    "layer": "app",
    "entries": {
      ".": "node"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vibesys": "./dist/launcher.js",
    "vs": "./dist/launcher.js"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "prepack": "pnpm run build",
    "test": "node ../scripts/run_bun_tests.mjs ./src ./dev"
  },
  "dependencies": {
    "@opentui/core": "0.4.3",
    "@vibesys/contracts": "workspace:*",
    "@vibesys/run-state": "workspace:*",
    "@vibesys/transport": "workspace:*",
    "@vibesys/transport-node": "workspace:*",
    "highlight.js": "11.11.2",
    "lowlight": "3.3.0"
  },
  "bundledDependencies": [
    "@vibesys/contracts",
    "@vibesys/run-state",
    "@vibesys/transport",
    "@vibesys/transport-node"
  ],
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
