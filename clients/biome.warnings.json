{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "extends": ["./biome.json"],
  "files": {
    "includes": [
      ".dependency-cruiser.mjs",
      "**/*.ts",
      "**/*.tsx",
      "tools/scripts/**/*.mjs",
      "!**/*.test.ts",
      "!**/*.test.tsx",
      "!**/dist",
      "!libs/contracts/src/generated",
      "!libs/proto/src/generated"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "warn",
          "options": { "maxLines": 1500 }
        }
      }
    }
  }
}
