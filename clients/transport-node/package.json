{
  "name": "@vibesys/transport-node",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "vibesys": {
    "layer": "domain",
    "entries": {
      ".": "node"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@vibesys/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.*.tsbuildinfo",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "check": "tsc -b",
    "test": "pnpm test:bun && pnpm test:node",
    "test:bun": "node ../scripts/run_bun_tests.mjs ./src",
    "test:node": "node ../scripts/run_node_tests.mjs ./src"
  },
  "dependencies": {
    "@vibesys/contracts": "workspace:*",
    "@vibesys/transport": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^24.0.0",
    "expect": "30.5.2",
    "typescript": "^5.8.3"
  }
}
