// ui/ may not reach the backend or the host platform. Backend access is `@vibesys/transport` and
// `@vibesys/transport-node` (and the desktop connection layer) only; `electron` and `node:*` are
// shell and main-process APIs.
language js;

or {
  `import $clause from $source`,
  `import * as $name from $source`,
  `import $source`
} as $import where {
  $source <: or { r".*@vibesys/transport.*", r".*electron.*", r".*node:.*" },
  register_diagnostic(
    span = $import,
    message = "ui/ must not import @vibesys/transport, @vibesys/transport-node, electron, or node:* modules. Receive data as props and emit events; the shell owns I/O.",
    severity = "error"
  )
}
