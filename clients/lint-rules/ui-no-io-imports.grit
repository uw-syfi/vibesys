// ui/ may not reach the backend or the host platform. Backend access is `backend-client` (and the
// desktop connection layer) only; `electron` and `node:*` are shell and main-process APIs.
language js;

or {
  `import $clause from $source`,
  `import * as $name from $source`,
  `import $source`
} as $import where {
  $source <: or { r".*@vibesys/backend-client.*", r".*electron.*", r".*node:.*" },
  register_diagnostic(
    span = $import,
    message = "ui/ must not import @vibesys/backend-client, electron, or node:* modules. Receive data as props and emit events; the shell owns I/O.",
    severity = "error"
  )
}
