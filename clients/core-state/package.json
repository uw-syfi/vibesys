{
  "name": "@vibesys/core-state",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @vibesys/core-state^... build",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.json",
    "precheck": "pnpm --filter @vibesys/core-state^... build",
    "check": "tsc -p tsconfig.check.json",
    "pretest": "pnpm --filter @vibesys/core-state^... build",
    "test": "bun test --max-concurrency 1 src",
    "bench:run-map": "bun bench/run-map.ts"
  },
  "dependencies": {
    "@vibesys/backend-client": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "typescript": "^5.8.3"
  }
}
