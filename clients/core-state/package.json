{
  "name": "@vibesys/core-state",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "vibesys": {
    "layer": "core",
    "entries": {
      ".": "neutral",
      "./testing": "neutral"
    }
  },
  "exports": {
    ".": {
      "@vibesys/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@vibesys/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json tsconfig.testing.json",
    "check": "tsc -b",
    "test": "node ../scripts/run_bun_tests.mjs ./src",
    "bench:performance": "bun bench/performance-projection.ts",
    "bench:run-map": "bun bench/run-map.ts"
  },
  "dependencies": {
    "@vibesys/backend-client": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "^5.8.3"
  }
}
