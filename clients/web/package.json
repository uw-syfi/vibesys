{
  "name": "@vibesys/web",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "vibesys": {
    "layer": "app",
    "entries": {
      ".": "dom"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:browser": "vite build --config vite.browser.config.ts",
    "build:desktop": "vite build --config vite.desktop.config.ts",
    "check": "tsc -b",
    "test": "node ../scripts/run_bun_tests.mjs ./src",
    "test:e2e": "turbo run build --filter=@vibesys/web... && playwright test"
  },
  "dependencies": {
    "@vibesys/backend-client": "workspace:*",
    "@vibesys/contracts": "workspace:*",
    "@vibesys/core-state": "workspace:*",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "^5.8.3"
  }
}
