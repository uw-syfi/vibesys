{
  "name": "@vibesys/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibesys": {
    "layer": "foundation",
    "entries": {
      ".": "dom",
      "./tokens.css": "dom"
    }
  },
  "exports": {
    ".": {
      "@vibesys/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": {
      "@vibesys/source": "./src/tokens.css",
      "default": "./src/tokens.css"
    }
  },
  "files": [
    "dist",
    "!dist/.*.tsbuildinfo",
    "src/tokens.css"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "check": "tsc -b",
    "test": "node ../scripts/run_bun_tests.mjs ./src"
  },
  "dependencies": {
    "react": "19.1.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "react-dom": "19.1.1",
    "typescript": "^5.8.3"
  }
}
