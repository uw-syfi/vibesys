{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.renderer.tsbuildinfo"
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx"
  ],
  "exclude": [
    "src/renderer/**/*.test.ts",
    "src/renderer/**/*.test.tsx"
  ],
  "references": [
    {
      "path": "./tsconfig.state.json"
    },
    {
      "path": "../../core-state/tsconfig.lib.json"
    },
    {
      "path": "../../entities/tsconfig.lib.json"
    },
    {
      "path": "../../ipc/tsconfig.lib.json"
    },
    {
      "path": "../../ui/tsconfig.lib.json"
    }
  ]
}
