      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.renderer.tsbuildinfo"
