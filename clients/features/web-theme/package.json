{
  "name": "@vibesys/feature-web-theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibesys": {
    "layer": "feature",
    "entries": {
      "./state": "neutral"
    }
  },
  "exports": {
    "./state": {
      "@vibesys/source": "./src/state/index.ts",
      "types": "./dist/state/index.d.ts",
      "default": "./dist/state/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.state.json",
    "check": "tsc -b",
    "test": "node ../../tools/scripts/run_bun_tests.mjs ./src"
  },
  "dependencies": {
    "@vibesys/contracts": "workspace:*",
    "@vibesys/machine": "workspace:*",
    "@vibesys/store": "workspace:*",
    "@vibesys/transport": "workspace:*",
    "xstate": "5.33.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "^5.8.3"
  }
}
