{
  "name": "@vibesys/feature-campaign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibesys": {
    "layer": "feature",
    "entries": {
      "./state": "neutral",
      "./renderer": "dom",
      "./styles.css": "dom"
    }
  },
  "exports": {
    "./state": {
      "@vibesys/source": "./src/state/index.ts",
      "types": "./dist/state/index.d.ts",
      "default": "./dist/state/index.js"
    },
    "./renderer": {
      "@vibesys/source": "./src/renderer/index.ts",
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    },
    "./styles.css": {
      "@vibesys/source": "./src/renderer/styles.css",
      "default": "./src/renderer/styles.css"
    }
  },
  "files": [
    "dist",
    "!dist/.*.tsbuildinfo",
    "src/renderer/styles.css"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.state.json tsconfig.renderer.json",
    "check": "tsc -b",
    "test": "node ../../tools/scripts/run_bun_tests.mjs ./src && node ../../tools/scripts/run_bun_tests.mjs ./dom-tests"
  },
  "dependencies": {
    "@vibesys/contracts": "workspace:*",
    "@vibesys/machine": "workspace:*",
    "@vibesys/store": "workspace:*",
    "xstate": "5.33.2",
    "react": "19.1.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "happy-dom": "20.14.5",
    "react-dom": "19.1.1",
    "typescript": "^5.8.3"
  }
}
