{
  "extends": "../../tools/tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "esnext.disposable"
    ],
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.main.tsbuildinfo"
  },
  "include": [
    "src/main/**/*.ts"
  ],
  "exclude": [
    "src/main/**/*.test.ts"
  ],
  "references": [
