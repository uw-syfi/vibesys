    },
    {
      "path": "../../libs/contracts/tsconfig.host-helper.json"
    },
    {
      "path": "../../libs/hosts/tsconfig.lib.json"
    },
    {
      "path": "../../libs/ipc/tsconfig.lib.json"
    },
    {
      "path": "../../libs/logs/tsconfig.lib.json"
    },
    {
      "path": "../../libs/settings/tsconfig.lib.json"
    }
  ]
}
