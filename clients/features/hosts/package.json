{
  "name": "@vibesys/feature-hosts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibesys": {
    "layer": "feature",
    "entries": {
      "./main": "node"
    }
  },
  "exports": {
    "./main": {
      "@vibesys/source": "./src/main/index.ts",
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.main.json",
    "check": "tsc -b",
    "test": "node ../../tools/scripts/run_bun_tests.mjs ./src"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^24.0.0",
    "@vibesys/proto": "workspace:*",
    "@vibesys/store": "workspace:*",
    "@vibesys/transport": "workspace:*",
    "fast-check": "4.10.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@vibesys/connection": "workspace:*",
    "@vibesys/contracts": "workspace:*",
    "@vibesys/hosts": "workspace:*",
    "@vibesys/ipc": "workspace:*",
    "@vibesys/logs": "workspace:*",
    "@vibesys/settings": "workspace:*"
  }
}
