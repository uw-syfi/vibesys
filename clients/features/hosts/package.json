{
  "name": "@vibesys/feature-hosts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibesys": {
    "layer": "feature",
    "entries": {
      "./state": "neutral",
      "./renderer": "dom",
      "./main": "node",
      "./styles.css": "dom"
    }
  },
  "exports": {
    "./state": {
      "@vibesys/source": "./src/state/index.ts",
      "types": "./dist/state/index.d.ts",
      "default": "./dist/state/index.js"
    },
    "./renderer": {
      "@vibesys/source": "./src/renderer/index.ts",
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    },
    "./main": {
      "@vibesys/source": "./src/main/index.ts",
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    },
    "./styles.css": {
      "@vibesys/source": "./src/renderer/styles.css",
      "default": "./src/renderer/styles.css"
    }
  },
  "files": [
    "dist",
    "!dist/.*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.state.json tsconfig.renderer.json tsconfig.main.json",
    "check": "tsc -b",
    "test": "node ../../scripts/run_bun_tests.mjs ./src"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vibesys/transport": "workspace:*",
    "happy-dom": "20.14.5",
    "react-dom": "19.1.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@vibesys/connection": "workspace:*",
    "@vibesys/contracts": "workspace:*",
    "@vibesys/hosts": "workspace:*",
    "@vibesys/ipc": "workspace:*",
    "@vibesys/settings": "workspace:*",
    "@vibesys/store": "workspace:*",
    "@vibesys/ui": "workspace:*",
    "react": "19.1.1"
  }
}
