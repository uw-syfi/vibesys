{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "globalDependencies": [
    "tools/tsconfig.base.json",
    "tools/scripts/run_bun_tests.mjs",
    "tools/scripts/run_node_tests.mjs",
    "tools/scripts/run_node_suite.mjs",
    "tools/scripts/run_vitest.mjs",
    "tools/scripts/test_runner_config.mjs",
    "tools/scripts/property_seed.mjs",
    "tools/scripts/property_seed.setup.mjs"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".tsbuild/**"]
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": ["dist/**", ".tsbuild/**"]
    },
    "test": {
      "dependsOn": ["transit"],
      "env": ["VIBESYS_PROPERTY_SEED", "VIBESYS_PROPERTY_PATH"],
      "outputs": []
    }
  }
}
