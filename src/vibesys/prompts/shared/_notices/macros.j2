{# Shared formatting for the hypothesis-search notice partials. #}
{% macro metric_row(metrics) %}{% for metric in metrics %}{{ metric.name }}={{ "%.6g"|format(metric.value) }} ({{ metric.direction }}){% if not loop.last %}, {% endif %}{% endfor %}{% endmacro %}
{% macro latest_line(latest) %}{% if latest is none %}Latest completed round: none.{% else %}Latest completed round: round {{ latest.round_number }}, commit {{ (latest.commit or "(missing)")[:12] }}, official metrics: {% if latest.official_metrics %}{{ metric_row(latest.official_metrics) }}{% elif latest.official_scalar is not none %}{{ ("%.6g"|format(latest.official_scalar.value) ~ " " ~ (latest.official_scalar.unit or ""))|trim }}{% else %}(none){% endif %}; retained: {{ latest.retained }}.{% endif %}{% endmacro %}
