{
  "name": "a_repeated_open_starts_one_agent",
  "doc": "A process says it holds nothing, is opened, then says who it holds. A second Open answers the same and starts no second agent.",
  "provider": [
    [
      {
        "say": "done",
        "item": "a1"
      }
    ]
  ],
  "steps": [
    {
      "hello": {
        "compatibility": "COMPATIBILITY_COMPATIBLE",
        "session": null
      }
    },
    {
      "open": {}
    },
    {
      "hello": {
        "compatibility": "COMPATIBILITY_COMPATIBLE",
        "session": {
          "agentId": "agent-1",
          "session": 1
        }
      }
    },
    {
      "open": {}
    },
    {
      "send": {
        "effectId": "e-t1",
        "startTurn": {
          "session": {
            "agentId": "agent-1",
            "session": 1
          },
          "turnId": "t1",
          "message": {
            "id": "msg-t1",
            "runId": "run-1",
            "toAgentId": "agent-1",
            "delivery": "DELIVERY_QUEUED",
            "at": "1970-01-01T00:00:01Z",
            "text": "do the thing"
          }
        }
      }
    },
    {
      "await": {
        "turn_ended": "t1"
      }
    },
    {
      "open": {}
    }
  ],
  "checks": [
    "opened_first",
    "offsets_increase",
    "one_end_per_turn",
    "one_agent_started"
  ]
}
